<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptimizarPC v4.0" Width="820" Height="660"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="BtnMain" TargetType="Button">
      <Setter Property="Background" Value="#00C8FF"/><Setter Property="Foreground" Value="#0D0D0D"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="22,9"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#33D6FF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#2A2A2A"/><Setter Property="Foreground" Value="#555555"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BtnSec" TargetType="Button">
      <Setter Property="Background" Value="#1E1E1E"/><Setter Property="Foreground" Value="#CCCCCC"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="14,7"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#2A2A2A"/><Setter Property="BorderBrush" Value="#00C8FF"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="#161616"/><Setter Property="Foreground" Value="#444444"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BtnPreset" TargetType="Button">
      <Setter Property="Background" Value="#161616"/><Setter Property="Foreground" Value="#AAAAAA"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#1E1E1E"/><Setter Property="BorderBrush" Value="#00C8FF"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#888888"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="16,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="bdr" Background="Transparent" BorderThickness="0,0,0,2"
                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="bdr" Property="BorderBrush" Value="#00C8FF"/>
            <Setter Property="Foreground" Value="#00C8FF"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#EEEEEE"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Background" Value="#1E1E1E"/>
      <Setter Property="Foreground" Value="#00C8FF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
          <Border x:Name="PART_Track">
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                    CornerRadius="4" HorizontalAlignment="Left"/>
          </Border>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BtnToggleOn" TargetType="Button">
      <Setter Property="Background" Value="#2A1212"/><Setter Property="Foreground" Value="#EF4444"/>
      <Setter Property="FontSize" Value="10"/><Setter Property="Padding" Value="8,4"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#3D1A1A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3D1A1A"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BtnToggleOff" TargetType="Button">
      <Setter Property="Background" Value="#122A12"/><Setter Property="Foreground" Value="#22C55E"/>
      <Setter Property="FontSize" Value="10"/><Setter Property="Padding" Value="8,4"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#1A3D1A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3D1A"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- HEADER -->
    <Border Grid.Row="0" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
      <Grid Margin="20,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="OptimizarPC" FontSize="17" FontWeight="SemiBold" Foreground="#EEEEEE" VerticalAlignment="Center"/>
          <TextBlock Text=" Universal"  FontSize="17" FontWeight="Light"    Foreground="#888888" VerticalAlignment="Center"/>
          <Border Background="#1E1E1E" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
            <TextBlock x:Name="lblVersion" Text="v4.0" FontSize="10" Foreground="#00C8FF"/>
          </Border>
          <!-- Badge laptop -->
          <Border x:Name="badgeLaptop" Background="#1A2A1A" CornerRadius="4" Padding="8,2" Margin="8,0,0,0" Visibility="Collapsed">
            <TextBlock Text="LAPTOP" FontSize="10" Foreground="#22C55E"/>
          </Border>
          <!-- Badge update (Collapsed hasta que haya update) -->
          <Border x:Name="badgeUpdate" Background="#2A1A00" CornerRadius="4" Padding="8,2" Margin="8,0,0,0"
                  Visibility="Collapsed" Cursor="Hand">
            <Border.ToolTip>
              <ToolTip Background="#1A1A1A" BorderBrush="#F59E0B" Foreground="#F59E0B" FontSize="11">
                <TextBlock x:Name="tooltipUpdate" Text="Hay una actualizacion disponible. Click para ver."/>
              </ToolTip>
            </Border.ToolTip>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x25B2; " FontSize="9" Foreground="#F59E0B" VerticalAlignment="Center"/>
              <TextBlock x:Name="lblUpdateBadge" Text="Actualizacion disponible" FontSize="10" Foreground="#F59E0B"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="4" Padding="8,3">
          <TextBlock x:Name="lblOS" Text="" FontSize="10" Foreground="#888888"/>
        </Border>
      </Grid>
    </Border>

    <!-- INFO SISTEMA -->
    <Border Grid.Row="1" Background="#111111" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="20,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"><TextBlock Text="CPU"   FontSize="10" Foreground="#555555"/>
          <TextBlock x:Name="lblCPU"  FontSize="11" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="GPU"   FontSize="10" Foreground="#555555"/>
          <TextBlock x:Name="lblGPU"  FontSize="11" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="RAM"   FontSize="10" Foreground="#555555"/>
          <TextBlock x:Name="lblRAM"  FontSize="11" Foreground="#CCCCCC"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="DISCO" FontSize="10" Foreground="#555555"/>
          <TextBlock x:Name="lblDisk" FontSize="11" Foreground="#CCCCCC"/></StackPanel>
      </Grid>
    </Border>

    <!-- TABS -->
    <TabControl Grid.Row="2" x:Name="mainTabs" Background="Transparent" BorderThickness="0">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
          <TabPanel IsItemsHost="True" Background="Transparent" Margin="12,0"/>
        </Border>
        <Border Grid.Row="1" Background="#0D0D0D"><ContentPresenter ContentSource="SelectedContent"/></Border>
      </Grid></ControlTemplate></TabControl.Template>

      <!-- TAB OPTIMIZAR -->
      <TabItem Header="Optimizar">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,14">

          <!-- PRESETS -->
          <Border Background="#0F1A1F" CornerRadius="8" BorderBrush="#1A3A4A" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="PRESETS" FontSize="10" FontWeight="SemiBold" Foreground="#006880"/>
                <TextBlock Text="Seleccion rapida" FontSize="11" Foreground="#555555"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnPresetGaming" Style="{StaticResource BtnPreset}" Content="Gaming"        Margin="0,0,8,0">
                  <Button.ToolTip><ToolTip Background="#1A1A1A" BorderBrush="#2A2A2A" Foreground="#CCCCCC" FontSize="11">Optimizacion maxima para gaming. Activa todos los tweaks de rendimiento, red y deshabilita servicios innecesarios.</ToolTip></Button.ToolTip>
                </Button>
                <Button x:Name="btnPresetProd"   Style="{StaticResource BtnPreset}" Content="Productividad" Margin="0,0,8,0">
                  <Button.ToolTip><ToolTip Background="#1A1A1A" BorderBrush="#2A2A2A" Foreground="#CCCCCC" FontSize="11">Limpieza y optimizacion basica. Conserva servicios utiles para trabajo diario.</ToolTip></Button.ToolTip>
                </Button>
                <Button x:Name="btnPresetSafe"   Style="{StaticResource BtnPreset}" Content="Conservador"   Margin="0,0,16,0">
                  <Button.ToolTip><ToolTip Background="#1A1A1A" BorderBrush="#2A2A2A" Foreground="#CCCCCC" FontSize="11">Solo limpieza de archivos y DNS. No modifica registro ni servicios. Ideal para equipos compartidos.</ToolTip></Button.ToolTip>
                </Button>
                <Button x:Name="btnSaveProfile"  Style="{StaticResource BtnPreset}" Content="Guardar perfil">
                  <Button.ToolTip><ToolTip Background="#1A1A1A" BorderBrush="#2A2A2A" Foreground="#CCCCCC" FontSize="11">Guarda tu seleccion actual como perfil. Se carga automaticamente la proxima vez que abras la app.</ToolTip></Button.ToolTip>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="LIMPIEZA DE ARCHIVOS" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
            <WrapPanel>
              <CheckBox x:Name="chkTempUser"  Content="Temp usuario"       IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Elimina archivos temporales del usuario (%TEMP%)</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkTempSys"   Content="Temp sistema"       IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Elimina temporales de Windows (C:\Windows\Temp)</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkPrefetch"  Content="Prefetch (SSD)"     IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Limpia Prefetch. Solo recomendado en SSD. En HDD puede afectar tiempos de arranque.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkWinUpdate" Content="Cache Win Update"   IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Elimina archivos de actualizaciones ya instaladas de Windows Update.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkBrowsers"  Content="Cache navegadores"  IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Limpia cache de Chrome, Edge, Firefox, Brave y Opera. No borra contrasenas ni historial.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkThumb"     Content="Thumbnails"         IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Elimina cache de miniaturas del Explorador. Se regenera automaticamente.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkRecycle"   Content="Papelera"           IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Vacia la papelera de reciclaje permanentemente.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkEventLogs" Content="Logs de eventos"    IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Limpia registros de eventos de Windows. Borra historial de errores del sistema.</ToolTip></CheckBox.ToolTip></CheckBox>
            </WrapPanel>
          </Border>

          <TextBlock Text="SISTEMA Y RENDIMIENTO" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
            <WrapPanel>
              <CheckBox x:Name="chkPower"      Content="Ultimate Performance"  IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Activa el plan Ultimate Performance. Elimina todos los ahorros de energia. No recomendado en laptop.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkHPET"       Content="Deshabilitar HPET"    IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Desactiva el High Precision Event Timer. Reduce jitter en frametimes y mejora consistencia.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkGPUPrio"    Content="GPU Priority"         IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">GPU Priority=8 en registro DXGI. Mejora scheduling de frames en juegos DirectX.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkScheduler"  Content="CPU Scheduler"        IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Win32PrioritySeparation=26. Prioriza procesos en primer plano con time slices cortos.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkPowerThrot" Content="Power Throttling OFF" IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Desactiva throttling de CPU por consumo energetico. Evita bajadas de frecuencia involuntarias.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkMemory"     Content="Optimizar memoria"    IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">LargeSystemCache=0 y DisablePagingExecutive=1. Prioriza RAM para aplicaciones activas.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkVisual"     Content="Efectos visuales min." IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Desactiva animaciones y efectos visuales de Windows para liberar CPU y GPU.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkMouseAccel" Content="Mouse accel OFF"      IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Desactiva aceleracion del mouse (MouseSpeed=0). Mejora precision en juegos.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkStartup"      Content="Punto restauracion"   IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Crea punto de restauracion antes de aplicar cambios. Permite revertir si algo falla.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkFastStartup"  Content="Fast Startup OFF"     IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Deshabilita el inicio rapido de Windows (HiberbootEnabled=0 + powercfg). Evita problemas con dual-boot, drivers y actualizaciones. Recomendado si usas Linux o tienes drivers inestables.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkPageFile"     Content="Optimizar PageFile"   IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Ajusta el PageFile a min/max fijo segun tu RAM para evitar fragmentacion. Si hay un disco secundario disponible, ofrece moverlo alli para liberar el disco del sistema.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkTrimDesfrag"  Content="TRIM / Desfrag"       IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">SSD: verifica y fuerza el schedule de TRIM semanal (Optimize-Volume). HDD: programa desfragmentacion semanal automatica. Se adapta al tipo de disco detectado.</ToolTip></CheckBox.ToolTip></CheckBox>
            </WrapPanel>
          </Border>

          <TextBlock Text="PRIVACIDAD Y TELEMETRIA" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
            <WrapPanel>
              <CheckBox x:Name="chkGameDVR"   Content="Game DVR / Xbox OFF" IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Desactiva Xbox Game DVR y Game Bar. Elimina overlay de grabacion que consume recursos en juegos.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkGameMode"  Content="Game Mode OFF"       IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Desactiva Game Mode de Windows. En AMD+Ryzen puede causar stutters. Recomendado OFF.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkTelemetry" Content="Telemetria Windows"  IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Desactiva envio de datos de diagnostico a Microsoft (AllowTelemetry=0).</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkCortana"   Content="Cortana OFF"         IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Deshabilita Cortana via politica de grupo. Reduce procesos en background.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkNotif"     Content="Notificaciones OFF"  IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Desactiva notificaciones toast. Evita interrupciones mientras se juega.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkTasks"     Content="Tareas telemetria"   IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Deshabilita tareas programadas de recopilacion de datos de Microsoft.</ToolTip></CheckBox.ToolTip></CheckBox>
            </WrapPanel>
          </Border>

          <TextBlock Text="RED Y CONECTIVIDAD" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
              <WrapPanel>
                <CheckBox x:Name="chkNagle"    Content="Nagle OFF"        IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Desactiva Algoritmo de Nagle (TcpAckFrequency=1, TCPNoDelay=1). Reduce latencia en juegos online.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkTCP"      Content="TCP/IP gaming"    IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Optimiza parametros TCP/IP via netsh: autotuning, RSS, FastOpen. Mejora latencia y throughput.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkDNSFlush" Content="Flush DNS"        IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Limpia la cache DNS local. Fuerza resolver nombres desde cero con los nuevos servidores.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkDisableIPv6" Content="Deshabilitar IPv6" IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Desactiva IPv6 en todos los adaptadores activos via Disable-NetAdapterBinding. Reduce latencia en redes que no usan IPv6. No afecta IPv4.</ToolTip></CheckBox.ToolTip></CheckBox>
              </WrapPanel>
              <!-- Selector de DNS -->
              <Border Background="#111111" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="1" Padding="12,9" Margin="0,6,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="chkDNS" Grid.Column="0" Content="Servidor DNS:" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center">
                    <CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Cambia el DNS de todos los adaptadores activos al proveedor seleccionado. Mas rapido y privado que el DNS del ISP.</ToolTip></CheckBox.ToolTip>
                  </CheckBox>
                  <ComboBox x:Name="cboDNSProvider" Grid.Column="1"
                            Background="#1E1E1E" Foreground="#CCCCCC" BorderBrush="#3A3A3A"
                            FontSize="12" Height="26" VerticalContentAlignment="Center"
                            HorizontalAlignment="Left" Width="220"
                            SelectedIndex="0">
                    <ComboBoxItem Content="Cloudflare  —  1.1.1.1 / 1.0.0.1"/>
                    <ComboBoxItem Content="Google      —  8.8.8.8 / 8.8.4.4"/>
                    <ComboBoxItem Content="Quad9       —  9.9.9.9 / 149.112.112.112"/>
                    <ComboBoxItem Content="AdGuard     —  94.140.14.14 / 94.140.15.15"/>
                  </ComboBox>
                  <TextBlock Grid.Column="2" x:Name="lblDNSHint" Text="Cloudflare  1.1.1.1 / 1.0.0.1"
                             FontSize="10" Foreground="#555555" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Text="SERVICIOS INNECESARIOS" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="14,12" Margin="0,0,0,4">
            <WrapPanel>
              <CheckBox x:Name="chkSvcXbox"    Content="Xbox Live"           IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Deshabilita XblAuthManager, XblGameSave y XboxNetApiSvc. No afecta juegos de Steam o Epic.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkSvcDiag"    Content="DiagTrack"           IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Deshabilita Connected User Experiences and Telemetry. Elimina envio de datos a Microsoft.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkSvcWER"     Content="Error Reporting"     IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Deshabilita Windows Error Reporting. Evita envio de reportes de crashes a Microsoft.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkSvcSysMain" Content="SysMain/Superfetch"  IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Deshabilita SysMain. Se aplica automaticamente solo si se detecto SSD. En HDD puede reducir rendimiento.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkSvcMaps"    Content="Maps / Geo"          IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Deshabilita MapsBroker y Geolocation. Innecesarios en PCs de escritorio y gaming.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkSvcFax"     Content="Fax / Remote Reg"    IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Deshabilita Fax y Remote Registry. Innecesarios y pueden ser vectores de ataque.</ToolTip></CheckBox.ToolTip></CheckBox>
              <CheckBox x:Name="chkSvcWSearch" Content="Windows Search (SSD)" IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Deshabilita el servicio WSearch (indexado de archivos). Reduce escrituras innecesarias en SSD y consumo de CPU/RAM en segundo plano. No afecta la busqueda manual, solo la indexacion automatica.</ToolTip></CheckBox.ToolTip></CheckBox>
            </WrapPanel>
          </Border>
        </StackPanel></ScrollViewer>
      </TabItem>

      <!-- TAB CONSOLA -->
      <TabItem Header="Consola">
        <Grid Margin="20,16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Background="#1A1A1A" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
              <TextBlock x:Name="lblLogStatus" Text="En espera..." FontSize="11" Foreground="#555555"/>
            </Border>
            <Button x:Name="btnClearLog"  Content="Limpiar"       Style="{StaticResource BtnSec}" Padding="12,4" FontSize="11" Margin="0,0,8,0"/>
            <Button x:Name="btnExportLog" Content="Exportar .txt" Style="{StaticResource BtnSec}" Padding="12,4" FontSize="11">
              <Button.ToolTip><ToolTip Background="#1A1A1A" Foreground="#CCCCCC" FontSize="11">Guarda el log en un archivo .txt con timestamp en tu carpeta Documentos.</ToolTip></Button.ToolTip>
            </Button>
          </StackPanel>
          <Border Grid.Row="1" Background="#0A0A0A" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1">
            <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto">
              <RichTextBox x:Name="rtbLog" Background="Transparent" FontFamily="Consolas"
                           FontSize="12" BorderThickness="0" IsReadOnly="True"
                           Padding="12" IsDocumentEnabled="True"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB ARRANQUE -->
      <TabItem Header="Arranque">
        <Grid Margin="20,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,12"
            Text="Programas que se inician con Windows (HKCU, HKLM y carpeta Startup). Deshabilitar no borra el programa, solo evita que arranque automaticamente."/>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnRefreshStartup" Content="Actualizar lista" Style="{StaticResource BtnSec}" Padding="14,6" Margin="0,0,8,0"/>
            <Border Background="#1A1A1A" CornerRadius="4" Padding="10,5" Margin="4,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="lblStartupStatus" Text="Cargando..." FontSize="11" Foreground="#555555"/>
            </Border>
          </StackPanel>

          <Border Grid.Row="2" Background="#0A0A0A" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#161616" CornerRadius="8,8,0,0" Padding="12,8" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="95"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="ESTADO"  FontSize="10" FontWeight="SemiBold" Foreground="#555555"/>
                  <TextBlock Grid.Column="1" Text="NOMBRE"  FontSize="10" FontWeight="SemiBold" Foreground="#555555"/>
                  <TextBlock Grid.Column="2" Text="ORIGEN"  FontSize="10" FontWeight="SemiBold" Foreground="#555555"/>
                  <TextBlock Grid.Column="3" Text="RUTA"    FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="8,0,0,0"/>
                  <TextBlock Grid.Column="4" Text="ACCION"  FontSize="10" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center"/>
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icStartup" Padding="0,4"/>
              </ScrollViewer>
            </Grid>
          </Border>

          <TextBlock Grid.Row="3" x:Name="lblStartupCount" Text="" FontSize="11" Foreground="#555555" Margin="0,8,0,0"/>
        </Grid>
      </TabItem>

      <!-- TAB HERRAMIENTAS -->
      <TabItem Header="Herramientas">
        <ScrollViewer Margin="20,16" VerticalScrollBarVisibility="Auto"><StackPanel>

          <TextBlock Text="BENCHMARK RAPIDO DE DISCO" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Mide velocidad de escritura y lectura secuencial con un archivo de 100 MB. Ejecuta antes y despues de optimizar para ver la mejora." FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="btnBenchmark" Content="Ejecutar Benchmark" Style="{StaticResource BtnMain}" Padding="18,8"/>
                <Border Background="#1A1A1A" CornerRadius="4" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="lblBenchStatus" Text="Listo" FontSize="11" Foreground="#555555"/>
                </Border>
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#111111" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="16,14">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ESCRITURA" FontSize="10" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <TextBlock x:Name="lblWriteSpeed" Text="--" FontSize="30" FontWeight="Bold" Foreground="#00C8FF"/>
                      <TextBlock Text=" MB/s" FontSize="13" Foreground="#555555" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                    </StackPanel>
                    <TextBlock x:Name="lblWriteCompare" Text="" FontSize="11" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#111111" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="16,14">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="LECTURA" FontSize="10" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <TextBlock x:Name="lblReadSpeed" Text="--" FontSize="30" FontWeight="Bold" Foreground="#00C8FF"/>
                      <TextBlock Text=" MB/s" FontSize="13" Foreground="#555555" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                    </StackPanel>
                    <TextBlock x:Name="lblReadCompare" Text="" FontSize="11" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="LIMPIEZA PROFUNDA DE CACHE" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Elimina IconCache.db, iconcache_*.db y thumbcache_*.db del Explorador de Windows." FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <Border Background="#1A1000" CornerRadius="5" BorderBrush="#3A2500" BorderThickness="1" Padding="10,8" Margin="0,0,0,12">
                <TextBlock Text="&#x26A0;  El Explorador se detendra y reiniciara automaticamente. La pantalla puede parpadear 2-3 segundos." FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap"/>
              </Border>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="btnDeepClean" Content="Limpiar Cache Profunda" Style="{StaticResource BtnMain}" Padding="18,8"/>
                <Border Background="#1A1A1A" CornerRadius="4" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="lblDeepCleanStatus" Text="Listo" FontSize="11" Foreground="#555555"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="LIBERADOR DE RAM" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="16" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,12"
                Text="Comprime los Working Sets de todos los procesos accesibles y vacia la Standby List del kernel. Util en equipos con poca RAM disponible."/>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#111111" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="12,12">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="TOTAL" FontSize="10" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="lblRAMTotal" Text="-- GB" FontSize="20" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#111111" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="12,12">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="EN USO" FontSize="10" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="lblRAMUsed" Text="-- GB" FontSize="20" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#111111" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="12,12">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="LIBRE" FontSize="10" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="lblRAMFree" Text="-- GB" FontSize="20" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="btnFreeRAM" Content="Liberar RAM ahora" Style="{StaticResource BtnMain}" Padding="18,8"/>
                <Border Background="#1A1A1A" CornerRadius="4" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="lblRAMFreeStatus" Text="Listo" FontSize="11" Foreground="#555555"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Info del sistema">
        <ScrollViewer Margin="20,16" VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="16" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Sistema operativo" FontSize="12" Foreground="#555555" Margin="0,4"/>
              <TextBlock Grid.Row="0" Grid.Column="1" x:Name="infoOS"   FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU"  FontSize="12" Foreground="#555555" Margin="0,4"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="infoCPU"  FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="GPU"  FontSize="12" Foreground="#555555" Margin="0,4"/>
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="infoGPU"  FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="RAM"  FontSize="12" Foreground="#555555" Margin="0,4"/>
              <TextBlock Grid.Row="3" Grid.Column="1" x:Name="infoRAM"  FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Text="Disco" FontSize="12" Foreground="#555555" Margin="0,4"/>
              <TextBlock Grid.Row="4" Grid.Column="1" x:Name="infoDisk" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
              <TextBlock Grid.Row="5" Grid.Column="0" Text="Tipo equipo" FontSize="12" Foreground="#555555" Margin="0,4"/>
              <TextBlock Grid.Row="5" Grid.Column="1" x:Name="infoType" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
            </Grid>
          </Border>
          <TextBlock Text="MONITOR EN TIEMPO REAL" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CPU" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" x:Name="pbCPU" Value="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" x:Name="lblCPUPct" Text="0%" FontSize="11" Foreground="#00C8FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="RAM" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" x:Name="pbRAM" Value="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" x:Name="lblRAMVal" Text="-- / -- GB" FontSize="11" Foreground="#00C8FF" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Disco" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" x:Name="pbDisk" Value="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" x:Name="lblDiskPct" Text="0%" FontSize="11" Foreground="#00C8FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="ESPACIO EN DISCO" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
          <Border Background="#161616" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="16">
            <ItemsControl x:Name="diskPanel"/>
          </Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- PROGRESO -->
    <Border Grid.Row="3" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="20,10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock x:Name="lblProgress" Text="Listo para optimizar" FontSize="11" Foreground="#555555" VerticalAlignment="Center"/>
          <TextBlock x:Name="lblPct"      Text=""                     FontSize="11" Foreground="#00C8FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ProgressBar Grid.Row="1" x:Name="progressBar" Value="0" Maximum="100"/>
      </Grid>
    </Border>

    <!-- FOOTER -->
    <Border Grid.Row="4" Background="#111111" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="lblSpaceFreed" Text="" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="btnSelAll"  Content="Seleccionar todo" Style="{StaticResource BtnSec}" Margin="0,0,8,0"/>
          <Button x:Name="btnSelNone" Content="Deseleccionar"    Style="{StaticResource BtnSec}" Margin="0,0,8,0"/>
          <Button x:Name="btnRun"     Content="Ejecutar optimizacion" Style="{StaticResource BtnMain}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
