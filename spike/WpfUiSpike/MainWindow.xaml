<ui:FluentWindow x:Class="WpfUiSpike.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:WpfUiSpike.Views"
                 mc:Ignorable="d"
                 Title="WinBoost — Spike WPF-UI"
                 Height="720" Width="1100"
                 MinHeight="500" MinWidth="820"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WinBoost — Spike WPF-UI (evaluación, descartable)">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Rocket24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                            Grid.Row="1"
                            PaneDisplayMode="Left"
                            OpenPaneLength="240"
                            IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Optimizar"
                                       Icon="{ui:SymbolIcon Rocket24}"
                                       TargetPageType="{x:Type views:DashboardPage}" />
                <ui:NavigationViewItem Content="Sistema"
                                       Icon="{ui:SymbolIcon Desktop24}"
                                       TargetPageType="{x:Type views:SistemaPage}" />
                <ui:NavigationViewItem Content="Avanzado"
                                       Icon="{ui:SymbolIcon Wrench24}"
                                       TargetPageType="{x:Type views:AvanzadoPage}" />
                <ui:NavigationViewItem Content="Ajustes"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type views:AjustesPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <!--
            Host del ContentDialog (item 8 del rediseño), UNO por ventana. Antes vivía dentro de
            DashboardPage.xaml: como NavigationCacheMode default es Disabled, cada vuelta a
            "Optimizar" recreaba la página y con ella un ContentDialogHost nuevo, y WPF-UI solo
            permite uno registrado por ventana -> InvalidOperationException a la segunda visita
            (ver 11_diag_crash_navegacion_spike.txt / 12_fix_crash_navegacion_spike.txt). Va acá,
            con RowSpan="2" para cubrir toda la ventana (TitleBar + contenido) al abrirse.
        -->
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
