<Application x:Class="WinBoost.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:WinBoost"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ===================================================================
             SISTEMA DE DISENO — tokens compartidos por toda la app y los dialogos
             (item 6.2). Acento unico, espaciado, tipografia, radios y estados.
             Las superficies (fondos/textos) siguen siendo DynamicResource por tema
             en MainWindow; estos tokens son constantes en claro y oscuro.
             =================================================================== -->

        <!-- Acento unico: una sola fuente de verdad para el color de marca.
             Variantes hover/pressed/subtle derivadas del mismo acento. -->
        <Color x:Key="AccentColor">#00C8FF</Color>
        <Color x:Key="AccentHoverColor">#33D6FF</Color>
        <Color x:Key="AccentPressedColor">#0088BB</Color>
        <Color x:Key="AccentSubtleColor">#08141A</Color>

        <SolidColorBrush x:Key="BrushAccent"        Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="BrushAccentHover"   Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource AccentPressedColor}"/>
        <SolidColorBrush x:Key="BrushAccentSubtle"  Color="{StaticResource AccentSubtleColor}"/>

        <!-- Colores de estado (ok/warn/err/info) -->
        <Color x:Key="OkColor">#22C55E</Color>
        <Color x:Key="WarnColor">#F59E0B</Color>
        <Color x:Key="ErrColor">#EF4444</Color>
        <SolidColorBrush x:Key="BrushOk"   Color="{StaticResource OkColor}"/>
        <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource WarnColor}"/>
        <SolidColorBrush x:Key="BrushErr"  Color="{StaticResource ErrColor}"/>
        <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource AccentColor}"/>

        <!-- Tipografia -->
        <FontFamily x:Key="FontFamilyBase">Segoe UI</FontFamily>
        <sys:Double x:Key="FontCaption">10</sys:Double>
        <sys:Double x:Key="FontSmall">11</sys:Double>
        <sys:Double x:Key="FontBody">12.5</sys:Double>
        <sys:Double x:Key="FontLabel">13</sys:Double>
        <sys:Double x:Key="FontSubtitle">14</sys:Double>
        <sys:Double x:Key="FontTitle">18</sys:Double>
        <sys:Double x:Key="FontDisplay">24</sys:Double>

        <!-- Espaciado (escala 4px) -->
        <sys:Double x:Key="SpaceXs">4</sys:Double>
        <sys:Double x:Key="SpaceSm">8</sys:Double>
        <sys:Double x:Key="SpaceMd">12</sys:Double>
        <sys:Double x:Key="SpaceLg">16</sys:Double>
        <sys:Double x:Key="SpaceXl">24</sys:Double>
        <Thickness x:Key="PadButton">22,9</Thickness>
        <Thickness x:Key="PadCard">12,10</Thickness>

        <!-- Radios de esquina -->
        <CornerRadius x:Key="RadiusSm">4</CornerRadius>
        <CornerRadius x:Key="RadiusMd">6</CornerRadius>
        <CornerRadius x:Key="RadiusLg">8</CornerRadius>

        <!-- Duracion estandar de transiciones de estado -->
        <Duration x:Key="DurFast">0:0:0.13</Duration>

    </Application.Resources>
</Application>
