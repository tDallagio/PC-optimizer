                         FontFamily="Consolas" FontSize="11"
                         Padding="12,9"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="btnActivateLicense" Grid.Column="1"
                        Content="Activar" Style="{StaticResource BtnMain}"
