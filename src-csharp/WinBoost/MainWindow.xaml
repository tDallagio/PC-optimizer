      </TabItem>

      <!-- TAB TUNING AVANZADO (F2.18/F2.19, indice 9) -->
      <TabItem Header="Tuning Avanzado" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,14,20,20">

          <!-- CARD 1 — Scheduler de CPU -->
          <Border Background="{DynamicResource BrushCard}" BorderBrush="{StaticResource BrushAccent}"
                  BorderThickness="0,0,0,2" CornerRadius="8" Padding="18,14,18,16" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="SCHEDULER DE CPU" FontSize="10" FontWeight="SemiBold"
                         Foreground="{StaticResource BrushAccent}" Margin="0,0,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock x:Name="lblPrioState" FontSize="13" FontWeight="SemiBold"
                             Margin="0,0,0,4" Text="Estado: --"/>
                  <TextBlock FontSize="11" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap"
                    Text="Da mas prioridad de CPU al proceso en primer plano frente a los de fondo. El efecto varia segun el sistema y el juego: puede notarse en la fluidez percibida y en los 1% low, o no notarse en hardware moderno. ON aplica 0x28 (prioridad alta al proceso activo); OFF vuelve al valor por defecto de Windows (2)."/>
                </StackPanel>
                <ui:ToggleSwitch x:Name="swPrio" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                  OnContent="Responsividad" OffContent="Default"/>
              </Grid>
              <TextBlock x:Name="lblPrioStatus" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- CARD 2 — HAGS -->
          <Border Background="{DynamicResource BrushCard}" BorderBrush="#A855F7"
                  BorderThickness="0,0,0,2" CornerRadius="8" Padding="18,14,18,16" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="ACELERACION GPU HARDWARE (HAGS)" FontSize="10" FontWeight="SemiBold"
                         Foreground="#A855F7" Margin="0,0,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock x:Name="lblHagsState" FontSize="13" FontWeight="SemiBold"
                             Margin="0,0,0,4" Text="Estado: --"/>
                  <TextBlock FontSize="11" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap"
                    Text="Delega el scheduling de frames de GPU al hardware en lugar del driver de pantalla. Reduce latencia de GPU en juegos y aplicaciones graficas intensivas. Requiere Windows 10 v2004+, GPU compatible y reinicio."/>
                </StackPanel>
                <ui:ToggleSwitch x:Name="swHags" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                  OnContent="Activo" OffContent="Inactivo"/>
              </Grid>
              <TextBlock x:Name="lblHagsResult" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- CARD 3 — Politica termica -->
          <Border Background="{DynamicResource BrushCard}" BorderBrush="#F59E0B"
                  BorderThickness="0,0,0,2" CornerRadius="8" Padding="18,14,18,16" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="POLITICA TERMICA" FontSize="10" FontWeight="SemiBold"
                         Foreground="#F59E0B" Margin="0,0,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock x:Name="lblCoolState" FontSize="13" FontWeight="SemiBold"
                             Margin="0,0,0,4" Text="Modo actual: --"/>
                  <TextBlock FontSize="11" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap"
                    Text="Activa: el plan de energia permite maxima frecuencia de CPU y ventiladores para mantener temperatura. Pasiva: el sistema reduce frecuencia de CPU antes de acelerar ventiladores (mas silencioso, algo menos de rendimiento)."/>
                </StackPanel>
                <ui:ToggleSwitch x:Name="swCool" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                  OnContent="Activa" OffContent="Pasiva"/>
              </Grid>
              <TextBlock x:Name="lblCoolResult" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

        </StackPanel></ScrollViewer>
      </TabItem>

      <!-- TAB TWEAKS (9) — Piloto Fase A (38_fase_a_registro_tweaks_piloto.txt). Cards generadas
           en codigo (BuildTweakCard, MainWindow.xaml.cs) a partir de App.Tweaks.All: es un
           registro extensible, no 5 bloques XAML a mano que haya que duplicar en la Fase B.
           No toca el tab Optimizar existente (checkboxes + Ejecutar siguen igual, en paralelo). -->
      <TabItem Header="Tweaks">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,14,20,20">
            <TextBlock Text="Piloto de 5 tweaks con toggle inmediato: prender aplica ya, apagar revierte ya."
                       FontSize="11" Foreground="{DynamicResource BrushFgMuted}" Margin="0,0,0,14"
                       TextWrapping="Wrap"/>
            <StackPanel x:Name="pnlTweaks"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      </TabControl>

      <!-- scoreWidget (SALUD) PRESERVADO COLAPSADO (reestructuracion 25): se saco del header
           full-width, pero su logica sigue viva (UpdateScoreWidget + delta post-optimizacion +
           AnimateScoreCount). La SALUD VISIBLE vive ahora solo en Info Sistema (UpdateScorePanel).
           Parkeado aca Collapsed: no ocupa layout y conserva todos sus x:Name para no romper el
           code-behind. Su antiguo deep-link (click -> Info) se removio del code-behind. -->
      <Grid x:Name="hiddenScoreHost" Grid.Column="1" Visibility="Collapsed">
        <Border x:Name="scoreWidget" Background="{DynamicResource BrushElev}" CornerRadius="6"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                Padding="12,6" Margin="0">
          <Border.ToolTip>
            <ToolTip x:Name="tooltipScore" Background="{DynamicResource BrushSidebar}"
                     BorderBrush="{DynamicResource BrushBorder}" FontSize="11" MaxWidth="280">
              <StackPanel>
                <TextBlock x:Name="lblScoreTooltipTitle" Text="Salud del sistema"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushFg1}" Margin="0,0,0,6"/>
                <TextBlock x:Name="lblScoreTooltipDetail" Text="Calculando..."
                           Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap"/>
              </StackPanel>
            </ToolTip>
          </Border.ToolTip>
          <StackPanel Orientation="Horizontal">
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock Text="SALUD" FontSize="9" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="lblScoreValue" Text="--"
                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushFgDim}"/>
                <TextBlock Text="%" FontSize="11" Foreground="{DynamicResource BrushFgDim}"
                           VerticalAlignment="Bottom" Margin="1,0,0,3"/>
              </StackPanel>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Width="6" Margin="0,0,8,0">
              <Border x:Name="scoreBar" Background="#2A2A2A"
                      CornerRadius="3" Width="6" Height="32">
                <Border.ToolTip><ToolTip Visibility="Collapsed"/></Border.ToolTip>
              </Border>
            </StackPanel>
            <Border x:Name="scoreDeltaBadge" Background="#0A2A0A" CornerRadius="4"
                    Padding="6,3" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock x:Name="lblScoreDelta" Text="+0" FontSize="11"
                         FontWeight="SemiBold" Foreground="#22C55E"/>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ============ CONSOLA OVERLAY (modal, fix 27) ============
           Reemplaza la pestaña Consola. Salta solo al ejecutar tareas con output (optimizacion,
           bloatware) en modo operacion, o se abre desde el icono navConsola en modo consulta.
           MODAL: el scrim cubre las dos columnas y captura input, la app queda bloqueada detras
           (el ui:TitleBar queda fuera del scrim a proposito: sigue habiendo minimizar/cerrar).
           FONDO DEL PANEL: semitransparente limpio (#EB141414 ~92%), SIN blur — el acrylic
           nativo de WPF-UI aplica a la ventana, no a paneles internos, y el BlurEffect casero
           penaliza GPU (inaceptable en el hardware objetivo). Se reporta: quedo semitransparente. -->
      <Border x:Name="consoleOverlay" Grid.Column="0" Grid.ColumnSpan="2"
              Background="#B3000000" Panel.ZIndex="200" Visibility="Collapsed">
        <!-- Opacidad del marco: #EB (~92%) -> #CC (~80%) -> #B3 (~70%) -> #A6 (~65%) -> #94 (~58%, fix 29c)
             para que el vidriado se note mas. Sin blur (semitransparencia limpia). El fondo del log va
             un poco mas opaco (#A6 ~65%) para legibilidad — ver Border del CUERPO abajo.
             fix 28.2: Height FIJO (no MaxHeight) -> el panel se ve igual vacio/ejecutando/completado;
             el log scrollea dentro de ese alto en vez de que el panel crezca. -->
        <Border Width="700" Height="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#94141414" CornerRadius="12"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
          <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="3" Opacity="0.6" Color="#000000"/>
          </Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER: icono + titulo + chip de estado | Limpiar / Exportar -->
            <Grid Grid.Row="0" Margin="20,16,20,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="14"
                           Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Text="Consola" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border x:Name="consoleStatusChip" Background="{DynamicResource BrushElev}" CornerRadius="4"
                        Padding="8,3" VerticalAlignment="Center">
                  <TextBlock x:Name="lblLogStatus" Text="En espera..." FontSize="10.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrushFgDim}"/>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnClearLog"  Content="Limpiar"       Style="{StaticResource BtnSec}" Padding="12,4" FontSize="11" Margin="0,0,8,0"/>
                <Button x:Name="btnExportLog" Content="Exportar .txt" Style="{StaticResource BtnSec}" Padding="12,4" FontSize="11" Margin="0,0,8,0">
                  <Button.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Guarda el log en un archivo .txt con timestamp en tu carpeta Documentos.</ToolTip></Button.ToolTip>
                </Button>
                <Button x:Name="btnExportHTML" Content="Exportar HTML" Style="{StaticResource BtnSec}" Padding="12,4" FontSize="11">
                  <Button.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Genera un reporte HTML standalone con info del sistema, score y acciones. Se abre en el navegador.</ToolTip></Button.ToolTip>
                </Button>
              </StackPanel>
            </Grid>

            <!-- CUERPO: log en vivo (rtbLog + logScroll movidos aca, x:Name intactos para AppLogger).
                 fix 29: el fondo del log dejo de ser el negro OPACO BrushDeep (#0A0A0A) — que se veia
                 como un rectangulo solido dentro del panel semitransparente — y pasa a #A6141414
                 (~65%, un poco mas opaco que el marco #94 ~58% para legibilidad del texto). El rtbLog
                 y el logScroll (ScrollViewer) ya son Transparent, asi que toman este color del Border. -->
            <Border Grid.Row="1" Background="#A6141414" CornerRadius="8"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="20,0">
              <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <RichTextBox x:Name="rtbLog" Background="Transparent" FontFamily="Consolas"
                             FontSize="12" BorderThickness="0" IsReadOnly="True"
                             Padding="12" IsDocumentEnabled="True"/>
              </ScrollViewer>
            </Border>

            <!-- PIE: progreso (progressBarConsole) + contador + Detener / Cerrar -->
            <StackPanel Grid.Row="2" Margin="20,12,20,16">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock x:Name="lblProgressConsole" Text="Listo" FontSize="11" Foreground="{DynamicResource BrushFgDim}" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblPctConsole"      Text=""      FontSize="11" Foreground="{StaticResource BrushAccent}" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <ProgressBar x:Name="progressBarConsole" Value="0" Maximum="100"
                           Style="{StaticResource ProgressBarActive}" Margin="0,0,0,12"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnConsoleStop"  Content="Detener" Style="{StaticResource BtnDanger}" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button x:Name="btnConsoleClose" Content="Cerrar"  Style="{StaticResource BtnSec}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <!-- ============ SYSTEM INFO OVERLAY (modal, fix 30) ============
           Reusa la infra del overlay de consola: scrim modal + panel centrado semitransparente
           (#94141414, mismo estilo/transparencia). Siempre cerrable (no hay operacion que
           proteger): boton Cerrar + click afuera. Contiene el hardware del equipo + el detalle
           de componentes que antes vivian en la pestaña Info del sistema (x:Name intactos). -->
      <Border x:Name="systemInfoOverlay" Grid.Column="0" Grid.ColumnSpan="2"
              Background="#B3000000" Panel.ZIndex="200" Visibility="Collapsed">
        <Border Width="760" Height="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#94141414" CornerRadius="12"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
          <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="3" Opacity="0.6" Color="#000000"/></Border.Effect>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="20,16,20,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Text="System Info" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Center"/>
              </StackPanel>
              <Button x:Name="btnSysInfoClose" Grid.Column="1" Content="Cerrar" Style="{StaticResource BtnSec}" Padding="12,4" FontSize="11"/>
            </Grid>

            <!-- CUERPO: hardware (izq) | componentes (der) -->
            <Grid Grid.Row="1" Margin="20,0,20,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

              <!-- HARDWARE DEL EQUIPO -->
              <Border Grid.Column="0" Background="#0F0F0F" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="HARDWARE DEL EQUIPO" FontSize="9" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,10"/>
                  <StackPanel Grid.Row="1">
                    <Border Background="#1E1E1E" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Sistema" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/><TextBlock x:Name="infoOS" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap"/></StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="#1E1E1E" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Procesador" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/><TextBlock x:Name="infoCPU" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap"/></StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="#1E1E1E" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Graficos" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/><TextBlock x:Name="infoGPU" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap"/></StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="#1E1E1E" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE964;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Memoria" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/><TextBlock x:Name="infoRAM" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap"/></StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="#1E1E1E" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Almacenamiento" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/><TextBlock x:Name="infoDisk" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap"/></StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="#1E1E1E" CornerRadius="6" Padding="10,8">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE782;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Windows" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/><TextBlock x:Name="infoType" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap"/></StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- DETALLE DE COMPONENTES -->
              <Border Grid.Column="2" Background="#0F0F0F" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="DETALLE DE COMPONENTES" FontSize="9" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,10"/>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icComponentsInfo"/>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>

            <!-- (pie vacio: el Cerrar esta en el header) -->
            <Border Grid.Row="2" Height="8"/>
          </Grid>
        </Border>
      </Border>

      <!-- TOAST in-app (auto-hide via DispatcherTimer; mirror de Show-ToastNotification).
           Overlay sobre las dos columnas, esquina inferior derecha. Collapsed por defecto. -->
      <Border x:Name="toastHost" Grid.Column="0" Grid.ColumnSpan="2"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,20,20" MaxWidth="340"
              Background="{DynamicResource BrushElev}" BorderBrush="{StaticResource BrushAccent}"
              BorderThickness="1" CornerRadius="8" Padding="16,12"
              Panel.ZIndex="100" Visibility="Collapsed">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Symbol" FontSize="16"
                     Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"
                     Margin="0,0,10,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="WinBoost" FontSize="11" FontWeight="SemiBold"
