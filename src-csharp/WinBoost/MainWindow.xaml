<ui:FluentWindow x:Class="WinBoost.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WinBoost" Width="1000" Height="720"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushAppBg}" FontFamily="Segoe UI"
        ExtendsContentIntoTitleBar="True">
  <ui:FluentWindow.Resources>

    <Style x:Key="BtnMain" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushAppBg}"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="{StaticResource PadButton}"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="bdr" CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
          <!-- Pincel inline NO congelado: animable para la transicion de hover (acento unico) -->
          <Border.Background><SolidColorBrush x:Name="bgMain" Color="{StaticResource AccentColor}"/></Border.Background>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <ColorAnimation Storyboard.TargetName="bgMain" Storyboard.TargetProperty="Color"
                              To="{StaticResource AccentHoverColor}" Duration="{StaticResource DurFast}"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <ColorAnimation Storyboard.TargetName="bgMain" Storyboard.TargetProperty="Color"
                              To="{StaticResource AccentColor}" Duration="{StaticResource DurFast}"/>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bdr" Property="Background" Value="{DynamicResource BrushBorder}"/><Setter Property="Foreground" Value="{DynamicResource BrushFgDim}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="BtnSec" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushFg2}"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="14,7"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="bdr" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
          <!-- Pinceles inline animables: fondo + borde con transicion al acento en hover -->
          <Border.Background><SolidColorBrush x:Name="bgSec" Color="{StaticResource CtrlColor}"/></Border.Background>
          <Border.BorderBrush><SolidColorBrush x:Name="bdSec" Color="{StaticResource BorderColor}"/></Border.BorderBrush>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <ColorAnimation Storyboard.TargetName="bgSec" Storyboard.TargetProperty="Color" To="{StaticResource BorderColor}" Duration="{StaticResource DurFast}"/>
              <ColorAnimation Storyboard.TargetName="bdSec" Storyboard.TargetProperty="Color" To="{StaticResource AccentColor}" Duration="{StaticResource DurFast}"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <ColorAnimation Storyboard.TargetName="bgSec" Storyboard.TargetProperty="Color" To="{StaticResource CtrlColor}" Duration="{StaticResource DurFast}"/>
              <ColorAnimation Storyboard.TargetName="bdSec" Storyboard.TargetProperty="Color" To="{StaticResource BorderColor}" Duration="{StaticResource DurFast}"/>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="bdr" Property="Background" Value="{DynamicResource BrushCard}"/><Setter Property="Foreground" Value="#444444"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="BtnPreset" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource BrushCard}"/><Setter Property="Foreground" Value="#AAAAAA"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource BrushCtrl}"/><Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushFg1}"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button">
      <Setter Property="Background" Value="#2A0A0A"/><Setter Property="Foreground" Value="{StaticResource BrushErr}"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,7"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#4A1A1A"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3D1212"/><Setter Property="BorderBrush" Value="{StaticResource BrushErr}"/></Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource BrushCard}"/><Setter Property="Foreground" Value="#444444"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="BtnToggleOn" TargetType="Button">
      <Setter Property="Background" Value="#2A1212"/><Setter Property="Foreground" Value="{StaticResource BrushErr}"/>
      <Setter Property="FontSize" Value="10"/><Setter Property="Padding" Value="8,4"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#3D1A1A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3D1A1A"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="BtnToggleOff" TargetType="Button">
      <Setter Property="Background" Value="#122A12"/><Setter Property="Foreground" Value="{StaticResource BrushOk}"/>
      <Setter Property="FontSize" Value="10"/><Setter Property="Padding" Value="8,4"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#1A3D1A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3D1A"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- CheckBox: adopcion WPF-UI paso 1 (15_adopcion_paso1_checkbox.txt) + ajustes de
         feedback posteriores. Cuadrado con relleno translucido "vidrio" de acento al marcar
         (sin checkmark: el glyph no quedaba centrado) y borde solido de acento. Blindado
         contra estilos implicitos de ToggleButton/CheckBox que aporten otras librerias: el
         Style sigue SIN x:Key a proposito (implicito, como ya estaba) para que se aplique a
         las 79 casillas de MainWindow.xaml sin tocar ninguna declaracion — ninguna tiene un
         Style local que pueda ganarle.
         Setters PLANOS (sin animacion/Storyboard) a proposito: la primera version animaba
         Background/BorderBrush con ColorAnimation vía Storyboard.TargetName (mismo patron que
         BtnMain/BtnSec), pero con DOS triggers independientes (IsChecked y hover) animando la
         misma propiedad (chkBrd.Color), un click real (mouse siempre encima al tildar) dispara
         ambos a la vez — carrera de Storyboards, el que gana no es determinista. Bug real
         reportado: al destildar y volver a tildar, el borde quedaba "apagado" en vez de
         acento. Fix: se volvio al patron del diseño original (Setter con TargetName sobre
         chkBorder, sin pinceles nombrados ni animacion) — la precedencia de WPF entre
         Setters de multiples triggers activos a la vez SI es deterministica (gana el ultimo
         trigger de la lista para la misma propiedad), a diferencia de Storyboards compitiendo. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="chkBorder" Width="16" Height="16" CornerRadius="{StaticResource RadiusSm}"
                      BorderBrush="#3A3A3A" BorderThickness="1.3"
                      Background="#1A1A1A" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#6600C8FF"/>
              </Trigger>
              <!-- Declarado DESPUES del hover a proposito: si esta tildado Y con mouse
                   encima, este gana (ultimo Setter de la misma propiedad vence) y el borde
                   se queda en acento solido en vez del tinte de hover. -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="chkBorder" Property="Background" Value="#4D00C8FF"/>
                <Setter TargetName="chkBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#555555"/>
                <Setter TargetName="chkBorder" Property="Background" Value="#161616"/>
                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#2A2A2A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- TabItem: borde inferior 3px, tinte activo -->
    <Style TargetType="TabItem">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#888888"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="16,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="bdr" Background="Transparent" BorderThickness="0,0,0,3"
                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            <Setter TargetName="bdr" Property="Background" Value="#08141A"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#EEEEEE"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ProgressBar default -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Background" Value="#1E1E1E"/>
      <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
          <Border x:Name="PART_Track">
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                    CornerRadius="4" HorizontalAlignment="Left"/>
          </Border>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- ProgressBar con gradiente para la barra principal -->
    <Style x:Key="ProgressBarActive" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Background" Value="#1E1E1E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
          <Border x:Name="PART_Track">
            <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                  <GradientStop Color="#0088BB" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Border>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Estilos CardStat para las cards de estadisticas -->
    <Style x:Key="CardStat" TargetType="Border">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CardStatGreen" TargetType="Border">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#22C55E"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CardStatAmber" TargetType="Border">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#F59E0B"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CardStatPurple" TargetType="Border">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#A855F7"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ScrollBar fino tema oscuro -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid x:Name="GridRoot" Width="6">
              <Border Background="#1A1A1A" CornerRadius="3"/>
              <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Height="0.001"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Height="0.001"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBdr" Background="#333333" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBdr" Property="Background" Value="#444444"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="GridRoot" Property="LayoutTransform">
                  <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                </Setter>
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="6"/>
          <Setter Property="MinHeight" Value="6"/>
        </Trigger>
      </Style.Triggers>
    </Style>


    <!-- Nav button base -->
    <Style x:Key="BtnNav" TargetType="Button">
      <Setter Property="Background"              Value="Transparent"/>
      <Setter Property="Foreground"              Value="#777777"/>
      <Setter Property="FontSize"                Value="12"/>
      <Setter Property="FontFamily"              Value="Segoe UI"/>
      <Setter Property="Padding"                 Value="10,9"/>
      <Setter Property="BorderThickness"         Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor"                  Value="Hand"/>
      <Setter Property="Margin"                  Value="0,1,0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bdr" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource BrushElev}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushFg2}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bdr" Property="Background" Value="#00C8FF10"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Nav button ACTIVO = PILL (fix 26). Template PROPIO (no el de BtnNav) a proposito:
         el template base tiene un trigger IsMouseOver que pinta el fondo gris (BrushElev), y
         como al seleccionar un item el mouse queda ENCIMA, ese trigger tapaba el fondo activo
         -> la pill no se veia. Aca el fondo pill (#12262E) SIEMPRE gana; el hover solo lo
         aclara un poco (sigue cyan), nunca gris. Misma geometria que BtnNav (Padding 10,9 via
         TemplateBinding, CornerRadius 8, Margin 0,1,0,1 heredado, sin borde) para que activar/
         desactivar no mueva el layout: solo cambia fondo + color. Texto/icono en acento por
         herencia de Foreground. -->
    <Style x:Key="BtnNavActive" TargetType="Button"
           BasedOn="{StaticResource BtnNav}">
      <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bdr" Background="#12262E"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bdr" Property="Background" Value="#16303A"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bdr" Property="Background" Value="#0E1F26"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Nav Licencia -->
    <Style x:Key="BtnNavLicense" TargetType="Button"
           BasedOn="{StaticResource BtnNav}">
      <Setter Property="Foreground"  Value="{StaticResource BrushWarn}"/>
      <Setter Property="FontWeight"  Value="SemiBold"/>
    </Style>

    <!-- Boton-icono de la fila inferior del sidebar (fix 27): Consola / Ajustes / Licencia.
         Solo icono, mas grande que los items de nav, centrado, reparte ancho por igual (van en
         un Grid de 3 columnas). Misma pill cyan (#12262E) del sidebar en hover/activo. -->
    <Style x:Key="BtnNavIcon" TargetType="Button">
      <Setter Property="Background"                 Value="Transparent"/>
      <Setter Property="Foreground"                 Value="#888888"/>
      <Setter Property="Cursor"                     Value="Hand"/>
      <Setter Property="BorderThickness"            Value="0"/>
      <Setter Property="Padding"                    Value="0,9"/>
      <Setter Property="Margin"                     Value="2,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment"   Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bdr" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bdr" Property="Background" Value="#12262E"/>
                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Boton-icono ACTIVO (Ajustes/Licencia mientras se esta en su seccion; Consola mientras
         el overlay esta abierto): pill fija #12262E, icono en acento. Misma geometria que el
         inactivo -> no salta el layout. Mismo criterio que BtnNavActive (fix 26). -->
    <Style x:Key="BtnNavIconActive" TargetType="Button"
           BasedOn="{StaticResource BtnNavIcon}">
      <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bdr" Background="#12262E"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bdr" Property="Background" Value="#16303A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Badge de errores en sidebar (Modulo 2.3) -->
    <Style x:Key="BtnErrBadge" TargetType="Button"
           BasedOn="{StaticResource BtnNav}">
      <Setter Property="Background"      Value="#2A0A0A"/>
      <Setter Property="Foreground"      Value="#EF4444"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush"     Value="#5A1515"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- TextBox tema oscuro (Modulo 12C) -->
    <Style x:Key="TxtDark" TargetType="TextBox">
      <Setter Property="Background"      Value="#0A0A0A"/>
      <Setter Property="Foreground"      Value="#CCCCCC"/>
      <Setter Property="BorderBrush"     Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush"      Value="{StaticResource BrushAccent}"/>
      <Setter Property="SelectionBrush"  Value="#00C8FF60"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Estilo de los items del dropdown -->
    <Style x:Key="ComboItemDark" TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#CCCCCC"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="itemBdr" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="itemBdr" Property="Background" Value="#00C8FF22"/>
                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="itemBdr" Property="Background" Value="#00C8FF15"/>
                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Estilo principal del ComboBox -->
    <Style x:Key="ComboDark" TargetType="ComboBox">
      <Setter Property="Background" Value="#1E1E1E"/>
      <Setter Property="Foreground" Value="#CCCCCC"/>
      <Setter Property="BorderBrush" Value="#3A3A3A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemDark}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="tgl" Focusable="False"
                            Style="{x:Null}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="cbBdr" Background="#1E1E1E"
                            BorderBrush="#3A3A3A" BorderThickness="1"
                            CornerRadius="6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x25BC;" Grid.Column="1" FontSize="9"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="cbBdr" Property="Background" Value="#252525"/>
                        <Setter TargetName="cbBdr" Property="BorderBrush" Value="#00C8FF60"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="cbBdr" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <TextBlock x:Name="cp"
                         Text="{Binding SelectionBoxItem,
                                RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="#CCCCCC"
                         FontSize="12"
                         Margin="10,0,28,0"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False"/>
              <Popup x:Name="popup" Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False"
                     PopupAnimation="Slide">
                <Border Background="#1A1A1A" BorderBrush="#3A3A3A"
                        BorderThickness="1" CornerRadius="6"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="240" Margin="0,2,0,0">
                  <ScrollViewer>
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#555555"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter TargetName="cp" Property="Foreground" Value="#666666"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardOptimizar" TargetType="Border">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ============ HOME / DASHBOARD (fix 30) ============
         GLOSSY: degrade + banda de reflejo (gratis). Glow del borde = BORDE SOLIDO de color
         (no DropShadowEffect) por la regla de performance: la pantalla de entrada esta siempre
         abierta y los medidores se actualizan cada segundo -> el halo difuminado x varias cards
         no vale el costo en hardware modesto. Reportado en CHANGELOG. -->

    <!-- Boton glossy primario (cyan) -->
    <Style x:Key="BtnGlossyCyan" TargetType="Button">
      <Setter Property="Foreground" Value="#04252E"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="bg" CornerRadius="8" BorderThickness="1" BorderBrush="#5FE0FF">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#33D6FF" Offset="0"/><GradientStop Color="#00A6D6" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border CornerRadius="8,8,0,0" VerticalAlignment="Top" Height="16" Margin="1,1,1,0" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#66FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.88"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Boton glossy secundario (oscuro) -->
    <Style x:Key="BtnGlossyDark" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushFg1}"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="bg" CornerRadius="8" BorderThickness="1" BorderBrush="#3A3A3A">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2C2C2C" Offset="0"/><GradientStop Color="#1A1A1A" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border CornerRadius="8,8,0,0" VerticalAlignment="Top" Height="16" Margin="1,1,1,0" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource BrushAccent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Card glossy base (para los medidores CPU/RAM/GPU) -->
    <Style x:Key="CardGlossy" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2E2E2E"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E1E1E" Offset="0"/><GradientStop Color="#141414" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- Pinceles tematizables — overridden en runtime por Apply-Theme -->
    <SolidColorBrush x:Key="BrushAppBg"   Color="#0D0D0D"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="#111111"/>
    <SolidColorBrush x:Key="BrushCard"    Color="#161616"/>
    <SolidColorBrush x:Key="BrushDeep"    Color="#0A0A0A"/>
    <SolidColorBrush x:Key="BrushElev"    Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BrushCtrl"    Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BrushBorder"  Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BrushFg1"     Color="#EEEEEE"/>
    <SolidColorBrush x:Key="BrushFg2"     Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BrushFgMuted" Color="#888888"/>
    <SolidColorBrush x:Key="BrushFgDim"   Color="#555555"/>
</ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Chrome Fluent (fundacion WPF-UI): reemplaza el titlebar nativo, que FluentWindow
         desactiva (CaptionHeight=0/UseAeroCaptionButtons=false) apenas se hereda de la
         clase, con o sin ExtendsContentIntoTitleBar. Sin esto la ventana queda sin forma
         de mover/minimizar/maximizar/cerrar. Solo chrome: el "TOP BAR" de marca propia de
         abajo (logo, version, badges, salud) es CONTENIDO y no se toca. -->
    <!-- ShowMaximize saca el boton de maximizar de la barra; CanMaximize tapa el otro camino que
         queda con chrome custom: el doble click sobre la barra de titulo, que lo maneja la propia
         TitleBar de WPF-UI y no el sistema. El resto de los caminos (arrastre de bordes, Win+flecha
         arriba) los bloquea ResizeMode="NoResize" a nivel de estilos de ventana de Windows. -->
    <ui:TitleBar Grid.Row="0" Title="WinBoost" ShowMaximize="False" CanMaximize="False"/>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="168"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===================== SIDEBAR (columna 0, full-height) =====================
           Reestructuracion layout maestro (25): se elimino el TOP BAR full-width y el
           layout paso de filas (header/contenido/footer) a columnas (sidebar | contenido).
           La marca (logo + WinBoost + chip de version + badge de licencia activo + badges
           laptop/update) se movio TAL CUAL aca arriba, conservando sus x:Name y su logica
           (UpdateLicenseBadge / lblVersion / badgeUpdate.Click). Navegacion reagrupada en
           PRINCIPAL / SISTEMA con item activo tipo pill (BtnNavActive). Ajustes + Licencia
           al fondo, separados por una linea. -->
      <Border Grid.Column="0" Background="{DynamicResource BrushSidebar}"
              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- bloque de marca -->
            <RowDefinition Height="*"/>      <!-- grupos de navegacion -->
            <RowDefinition Height="Auto"/>   <!-- badge de errores -->
            <RowDefinition Height="Auto"/>   <!-- Ajustes + Licencia -->
          </Grid.RowDefinitions>

          <!-- BLOQUE DE MARCA (movido desde el TOP BAR); separado de la nav con linea inferior -->
          <Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <StackPanel Margin="14,16,12,14">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#00C8FF18" CornerRadius="8"
                        BorderBrush="#00C8FF40" BorderThickness="1"
                        Width="30" Height="30" Margin="0,0,9,0" VerticalAlignment="Center">
                  <ui:SymbolIcon Symbol="Flash20" FontSize="18" Width="18" Height="18"
                                 Foreground="{StaticResource BrushAccent}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- Margin="0,-1,0,1" = correccion optica (ver historial): sube el wordmark 1px
                     sin cambiar el alto. A FontSize 17 la correccion ~= 17*0.054 ~= 0.9px. -->
                <TextBlock FontSize="17" VerticalAlignment="Center" Margin="0,-1,0,1"
                           Foreground="{DynamicResource BrushFg1}">
                  <Run Text="Win" FontWeight="Regular"/><Run Text="Boost" FontWeight="Bold"/>
                </TextBlock>
              </StackPanel>
              <!-- Fila: chip de version + badge de licencia activo (solo uno visible por vez,
                   gobernado por UpdateLicenseBadge()). WrapPanel para que fluya si no entra. -->
              <WrapPanel Margin="0,11,0,0">
                <Border Background="Transparent" CornerRadius="5"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        Padding="8,2" Margin="0,0,6,6" VerticalAlignment="Center">
                  <TextBlock x:Name="lblVersion" Text="" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrushFgMuted}"/>
                </Border>
                <Border x:Name="badgeLicenseFree" Background="Transparent" CornerRadius="6"
                        BorderBrush="#3A3A3A" BorderThickness="1"
                        Padding="9,2" Margin="0,0,6,6" VerticalAlignment="Center">
                  <TextBlock Text="FREE" FontSize="10" Foreground="#8A8A8A" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="badgeLicensePro" Background="#281A06" CornerRadius="6"
                        BorderBrush="#7A4E18" BorderThickness="1"
                        Padding="9,2" Margin="0,0,6,6" Visibility="Collapsed" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Crown16" FontSize="12" Width="12" Height="12" Foreground="#E8A044"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="PRO" FontSize="10" Foreground="#E8A044" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <Border x:Name="badgeLicenseTech" Background="#0A1E24" CornerRadius="6"
                        BorderBrush="#1E6E85" BorderThickness="1"
                        Padding="9,2" Margin="0,0,6,6" Visibility="Collapsed" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ShieldCheckmark16" FontSize="12" Width="12" Height="12" Foreground="#33D6FF"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="TECH" FontSize="10" Foreground="#33D6FF" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <Border x:Name="badgeLicenseTrial" Background="#1A1200" CornerRadius="6"
                        BorderBrush="#7A5A12" BorderThickness="1"
                        Padding="9,2" Margin="0,0,6,6" Visibility="Collapsed" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Clock16" FontSize="12" Width="12" Height="12" Foreground="#F5B944"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="PRUEBA" FontSize="10" Foreground="#F5B944" FontWeight="SemiBold" Margin="0,0,3,0"/>
                    <TextBlock x:Name="lblLicenseTrialDays" Text="" FontSize="10" Foreground="#F5B944" Opacity="0.75"/>
                  </StackPanel>
                </Border>
              </WrapPanel>
              <!-- Badges de estado laptop/update (movidos; visibles solo segun deteccion/updater).
                   badgeUpdate conserva su tooltip y su MouseLeftButtonUp (cableado en code-behind). -->
              <WrapPanel>
                <Border x:Name="badgeLaptop" Background="#1A2A1A" CornerRadius="6"
                        Padding="9,3" Margin="0,0,6,0" Visibility="Collapsed"
                        VerticalAlignment="Center">
                  <TextBlock Text="LAPTOP" FontSize="10" Foreground="#22C55E"/>
                </Border>
                <Border x:Name="badgeUpdate" Background="#2A1A00" CornerRadius="6"
                        Padding="9,3" Margin="0,0,6,0" Visibility="Collapsed" Cursor="Hand"
                        VerticalAlignment="Center">
                  <Border.ToolTip>
                    <ToolTip Background="{DynamicResource BrushElev}" BorderBrush="#F59E0B"
                             Foreground="#F59E0B" FontSize="11">
                      <TextBlock x:Name="tooltipUpdate"
                                 Text="Hay una actualizacion disponible. Click para ver."/>
                    </ToolTip>
                  </Border.ToolTip>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25B2; " FontSize="9" Foreground="#F59E0B"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblUpdateBadge" Text="Actualizacion disponible"
                               FontSize="10" Foreground="#F59E0B"/>
                  </StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- GRUPOS DE NAVEGACION: PRINCIPAL / SISTEMA. Los x:Name y el orden del array
               _navButtons (indexado por tab) NO cambian: solo cambia el orden VISUAL. Cada
               nav.Click sigue mapeando a su SetActiveNav(indiceFijo), asi que no hace falta
               recablear indices. -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,10,8,0">
              <!-- Home = entrada de la app (fix 30). Item arriba de todo; mapea al tab index 2
                   (ex Info del sistema, eliminada). -->
              <Button x:Name="navHome" Style="{StaticResource BtnNav}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                             FontSize="15" Width="22" VerticalAlignment="Center"/>
                  <TextBlock Text="Home" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock Text="PRINCIPAL" FontSize="9.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushFgDim}" Margin="8,2,0,4"/>
              <Button x:Name="navOptimizar" Style="{StaticResource BtnNav}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Symbol"
                             FontSize="15" Width="22" VerticalAlignment="Center"/>
                  <TextBlock Text="Optimizar" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="navHerramientas" Style="{StaticResource BtnNav}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol"
                             FontSize="16" Width="22" VerticalAlignment="Center"/>
                  <TextBlock Text="Herramientas" VerticalAlignment="Center"/>
                  <Border x:Name="badgeDeviceProblems" Background="#F59E0B"
                          CornerRadius="5" Width="8" Height="8"
                          VerticalAlignment="Center" Margin="5,0,0,0"
                          Visibility="Collapsed"/>
                </StackPanel>
              </Button>
              <Button x:Name="navTuning" Style="{StaticResource BtnNav}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Symbol"
                             FontSize="15" Width="22" VerticalAlignment="Center"/>
                  <TextBlock Text="Tuning Avanzado" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="navBloatware" Style="{StaticResource BtnNav}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#x2297;" FontFamily="Segoe UI Symbol"
                             FontSize="15" Width="22" VerticalAlignment="Center"/>
                  <TextBlock Text="Bloatware" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <TextBlock Text="SISTEMA" FontSize="9.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushFgDim}" Margin="8,12,0,4"/>
              <!-- navInfo eliminado (fix 30): Info del sistema dejo de ser tab; su data vive en el
                   Home + el overlay System Info. -->
              <Button x:Name="navArranque" Style="{StaticResource BtnNav}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#x25B3;" FontFamily="Segoe UI Symbol"
                             FontSize="14" Width="22" VerticalAlignment="Center"/>
                  <TextBlock Text="Arranque" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="navHistorial" Style="{StaticResource BtnNav}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#x23F1;" FontFamily="Segoe UI Symbol"
                             FontSize="14" Width="22" VerticalAlignment="Center"/>
                  <TextBlock Text="Historial" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- Piloto Fase A (38_fase_a_registro_tweaks_piloto.txt): grupo propio, separado
                   de PRINCIPAL/SISTEMA a proposito, son 5 tweaks piloto con toggle inmediato,
                   no la pestaña Optimizar existente (que sigue intacta en paralelo). -->
              <TextBlock Text="TWEAKS" FontSize="9.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushFgDim}" Margin="8,12,0,4"/>
              <Button x:Name="navTweaks" Style="{StaticResource BtnNav}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                             FontSize="15" Width="22" VerticalAlignment="Center"/>
                  <TextBlock Text="Tweaks" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>

          <!-- Badge de errores (oculto hasta que haya errores) -> Consola (deep-link intacto) -->
          <Button x:Name="btnErrBadge" Grid.Row="2" Margin="8,0,8,8"
                  Visibility="Collapsed"
                  Style="{StaticResource BtnErrBadge}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Text="&#x26A0;" FontFamily="Segoe UI Symbol"
                         FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <TextBlock x:Name="lblErrCount" FontSize="10.5" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- FILA DE ICONOS al fondo (fix 27, estilo Discord): Consola / Ajustes / Licencia,
               separada del resto por una linea, repartiendo el ancho por igual (Grid 3 cols).
               Consola ABRE EL OVERLAY (no navega); Ajustes/Licencia siguen navegando a su tab
               (su navegacion se preserva). Tooltip arriba con la categoria. Iconos ~18px. -->
          <StackPanel Grid.Row="3" Margin="8,0,8,10">
            <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="navConsola" Grid.Column="0" Style="{StaticResource BtnNavIcon}">
                <Button.ToolTip>
                  <ToolTip Placement="Top" Background="{DynamicResource BrushElev}"
                           BorderBrush="{DynamicResource BrushBorder}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Consola</ToolTip>
                </Button.ToolTip>
                <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <Button x:Name="navAjustes" Grid.Column="1" Style="{StaticResource BtnNavIcon}">
                <Button.ToolTip>
                  <ToolTip Placement="Top" Background="{DynamicResource BrushElev}"
                           BorderBrush="{DynamicResource BrushBorder}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Ajustes</ToolTip>
                </Button.ToolTip>
                <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <Button x:Name="navLicencia" Grid.Column="2" Style="{StaticResource BtnNavIcon}">
                <Button.ToolTip>
                  <ToolTip Placement="Top" Background="{DynamicResource BrushElev}"
                           BorderBrush="{DynamicResource BrushBorder}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Licencia</ToolTip>
                </Button.ToolTip>
                <TextBlock Text="&#x2605;" FontFamily="Segoe UI Symbol" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- TABS (sin TabPanel visible, navegacion via sidebar) -->
      <TabControl Grid.Column="1" x:Name="mainTabs" Background="Transparent" BorderThickness="0">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <Border Background="{DynamicResource BrushAppBg}">
              <ContentPresenter ContentSource="SelectedContent"/>
            </Border>
          </ControlTemplate>
        </TabControl.Template>

      <!-- TAB OPTIMIZAR -->
      <TabItem Header="Optimizar">
        <!-- Reestructuracion 25: la pestaña Optimizar aloja la BARRA DE ACCION FIJA (ex footer
             global) al fondo. Row 0 = contenido scrolleable; Row 1 = barra de accion. -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,14">

          <!-- PRESETS -->
          <Border Background="#0F1A1F" CornerRadius="8" BorderBrush="#1A3A4A" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="PRESETS" FontSize="10" FontWeight="SemiBold" Foreground="#006880"/>
                <TextBlock Text="Seleccion rapida" FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnPresetGaming" Style="{StaticResource BtnPreset}" Content="Gaming"        Margin="0,0,8,0">
                  <Button.ToolTip><ToolTip Background="{DynamicResource BrushElev}" BorderBrush="{DynamicResource BrushBorder}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Optimizacion maxima para gaming. Activa todos los tweaks de rendimiento, red y deshabilita servicios innecesarios.</ToolTip></Button.ToolTip>
                </Button>
                <Button x:Name="btnPresetProd"   Style="{StaticResource BtnPreset}" Content="Productividad" Margin="0,0,8,0">
                  <Button.ToolTip><ToolTip Background="{DynamicResource BrushElev}" BorderBrush="{DynamicResource BrushBorder}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Limpieza y optimizacion basica. Conserva servicios utiles para trabajo diario.</ToolTip></Button.ToolTip>
                </Button>
                <Button x:Name="btnPresetSafe"   Style="{StaticResource BtnPreset}" Content="Conservador"   Margin="0,0,16,0">
                  <Button.ToolTip><ToolTip Background="{DynamicResource BrushElev}" BorderBrush="{DynamicResource BrushBorder}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Solo limpieza de archivos y DNS. No modifica registro ni servicios. Ideal para equipos compartidos.</ToolTip></Button.ToolTip>
                </Button>
                <Button x:Name="btnSaveProfile"  Style="{StaticResource BtnPreset}" Content="Guardar perfil">
                  <Button.ToolTip><ToolTip Background="{DynamicResource BrushElev}" BorderBrush="{DynamicResource BrushBorder}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Guarda tu seleccion actual como perfil. Se carga automaticamente la proxima vez que abras la app.</ToolTip></Button.ToolTip>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <!-- LIMPIEZA DE ARCHIVOS -->
          <TextBlock Text="LIMPIEZA DE ARCHIVOS" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" Margin="0,0,0,8"/>
          <Border Style="{StaticResource CardOptimizar}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Column="0" Fill="#22C55E"/>
              <WrapPanel Grid.Column="1" Margin="14,12,14,12">
                <CheckBox x:Name="chkTempUser"  Content="Temp usuario"       IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Elimina archivos temporales del usuario (%TEMP%)</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkTempSys"   Content="Temp sistema"       IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Elimina temporales de Windows (C:\Windows\Temp)</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkPrefetch"  Content="Prefetch (SSD)"     IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Limpia Prefetch. Solo recomendado en SSD. En HDD puede afectar tiempos de arranque.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkWinUpdate" Content="Cache Win Update"   IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Elimina archivos de actualizaciones ya instaladas de Windows Update.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkBrowsers"  Content="Cache navegadores"  IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Limpia cache de Chrome, Edge, Firefox, Brave y Opera. No borra contrasenas ni historial.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkThumb"     Content="Thumbnails"         IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Elimina cache de miniaturas del Explorador. Se regenera automaticamente.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkRecycle"   Content="Papelera"           IsChecked="True"  Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Vacia la papelera de reciclaje permanentemente.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkEventLogs" Content="Logs de eventos" IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="#EF4444" FontSize="11" MaxWidth="300">IMPACTO ALTO: borra logs de Aplicacion, Sistema y otros canales. El log de Seguridad NO se toca. Elimina registros forenses del sistema. No se activa con Seleccionar todo.</ToolTip></CheckBox.ToolTip></CheckBox>
              </WrapPanel>
            </Grid>
          </Border>

          <!-- SISTEMA Y RENDIMIENTO -->
          <TextBlock Text="SISTEMA Y RENDIMIENTO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,8"/>
          <Border Style="{StaticResource CardOptimizar}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Column="0" Fill="{StaticResource BrushAccent}"/>
              <WrapPanel Grid.Column="1" Margin="14,12,14,12">
                <CheckBox x:Name="chkPower"      Content="Ultimate Performance"  IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Activa el plan Ultimate Performance. Elimina todos los ahorros de energia. No recomendado en laptop.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkHPET"       Content="Deshabilitar HPET"    IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Desactiva el High Precision Event Timer. Reduce jitter en frametimes y mejora consistencia.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkGPUPrio"    Content="GPU Priority"         IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">GPU Priority=8 en registro DXGI. Mejora scheduling de frames en juegos DirectX.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkPowerThrot" Content="Power Throttling OFF" IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Desactiva throttling de CPU por consumo energetico. Evita bajadas de frecuencia involuntarias.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkVisual"     Content="Efectos visuales min." IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Desactiva animaciones y efectos visuales de Windows para liberar CPU y GPU.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkMouseAccel" Content="Mouse accel OFF"      IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Desactiva aceleracion del mouse (MouseSpeed=0). Mejora precision en juegos.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkStartup"      Content="Punto restauracion"   IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Crea punto de restauracion antes de aplicar cambios. Permite revertir si algo falla.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkFastStartup"  Content="Fast Startup OFF"     IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Deshabilita el inicio rapido de Windows (HiberbootEnabled=0 + powercfg). Evita problemas con dual-boot, drivers y actualizaciones. Recomendado si usas Linux o tienes drivers inestables.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkPageFile"     Content="Optimizar PageFile"   IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Ajusta el PageFile a min/max fijo segun tu RAM para evitar fragmentacion. Si hay un disco secundario disponible, ofrece moverlo alli para liberar el disco del sistema.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkTrimDesfrag"  Content="TRIM / Desfrag"       IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">SSD: verifica y fuerza el schedule de TRIM semanal (Optimize-Volume). HDD: programa desfragmentacion semanal automatica. Se adapta al tipo de disco detectado.</ToolTip></CheckBox.ToolTip></CheckBox>
              </WrapPanel>
            </Grid>
          </Border>

          <!-- PRIVACIDAD Y TELEMETRIA -->
          <TextBlock Text="PRIVACIDAD Y TELEMETRIA" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,0,0,8"/>
          <Border Style="{StaticResource CardOptimizar}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Column="0" Fill="#EF4444"/>
              <WrapPanel Grid.Column="1" Margin="14,12,14,12">
                <CheckBox x:Name="chkGameDVR"   Content="Game DVR / Xbox OFF" IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Desactiva Xbox Game DVR y Game Bar. Elimina overlay de grabacion que consume recursos en juegos.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkGameMode"  Content="Game Mode OFF"       IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Desactiva Game Mode de Windows. En AMD+Ryzen puede causar stutters. Recomendado OFF.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkTelemetry" Content="Telemetria Windows"  IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Desactiva envio de datos de diagnostico a Microsoft (AllowTelemetry=0).</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkCortana"   Content="Cortana OFF"         IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Deshabilita Cortana via politica de grupo. Reduce procesos en background.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkNotif"     Content="Notificaciones OFF"  IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Desactiva notificaciones toast. Evita interrupciones mientras se juega.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkTasks"     Content="Tareas telemetria"   IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Deshabilita tareas programadas de recopilacion de datos de Microsoft.</ToolTip></CheckBox.ToolTip></CheckBox>
              </WrapPanel>
            </Grid>
          </Border>

          <!-- RED Y CONECTIVIDAD -->
          <TextBlock Text="RED Y CONECTIVIDAD" FontSize="11" FontWeight="SemiBold" Foreground="#A855F7" Margin="0,0,0,8"/>
          <Border Style="{StaticResource CardOptimizar}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Column="0" Fill="#A855F7"/>
              <StackPanel Grid.Column="1" Margin="14,12,14,12">
                <WrapPanel>
                  <CheckBox x:Name="chkNagle"    Content="Nagle OFF"        IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Desactiva Algoritmo de Nagle (TcpAckFrequency=1, TCPNoDelay=1). Reduce latencia en juegos online.</ToolTip></CheckBox.ToolTip></CheckBox>
                  <CheckBox x:Name="chkTCP"      Content="TCP/IP gaming"    IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Optimiza parametros TCP/IP via netsh: autotuning, RSS, FastOpen. Mejora latencia y throughput.</ToolTip></CheckBox.ToolTip></CheckBox>
                  <CheckBox x:Name="chkDNSFlush" Content="Flush DNS"        IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Limpia la cache DNS local. Fuerza resolver nombres desde cero con los nuevos servidores.</ToolTip></CheckBox.ToolTip></CheckBox>
                  <CheckBox x:Name="chkDisableIPv6" Content="Preferir IPv4" IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Configura Windows para preferir IPv4 sobre IPv6 (DisabledComponents=0x20). IPv6 sigue funcionando. Seguro en redes IPv6-nativas. Omitir si usas Teredo o servicios IPv6-only.</ToolTip></CheckBox.ToolTip></CheckBox>
                </WrapPanel>
                <!-- Selector de DNS -->
                <Border Background="{DynamicResource BrushSidebar}" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="12,9" Margin="0,6,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="chkDNS" Grid.Column="0" Content="Servidor DNS:" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center">
                      <CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Cambia el DNS de todos los adaptadores activos al proveedor seleccionado. Mas rapido y privado que el DNS del ISP.</ToolTip></CheckBox.ToolTip>
                    </CheckBox>
                    <ComboBox x:Name="cboDNSProvider" Grid.Column="1"
                              Style="{StaticResource ComboDark}"
                              HorizontalAlignment="Left" Width="220"
                              SelectedIndex="0">
                      <ComboBoxItem Content="Cloudflare  --  1.1.1.1 / 1.0.0.1"/>
                      <ComboBoxItem Content="Google      --  8.8.8.8 / 8.8.4.4"/>
                      <ComboBoxItem Content="Quad9       --  9.9.9.9 / 149.112.112.112"/>
                      <ComboBoxItem Content="AdGuard     --  94.140.14.14 / 94.140.15.15"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" x:Name="lblDNSHint" Text="Cloudflare  1.1.1.1 / 1.0.0.1"
                               FontSize="10" Foreground="{DynamicResource BrushFgDim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <!-- SERVICIOS INNECESARIOS -->
          <TextBlock Text="SERVICIOS INNECESARIOS" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,0,8"/>
          <Border Style="{StaticResource CardOptimizar}" Margin="0,0,0,4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Column="0" Fill="#F59E0B"/>
              <WrapPanel Grid.Column="1" Margin="14,12,14,12">
                <CheckBox x:Name="chkSvcXbox"    Content="Xbox Live"           IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Deshabilita XblAuthManager, XblGameSave y XboxNetApiSvc. No afecta juegos de Steam o Epic.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkSvcDiag"    Content="DiagTrack"           IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Deshabilita Connected User Experiences and Telemetry. Elimina envio de datos a Microsoft.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkSvcWER"     Content="Error Reporting"     IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Deshabilita Windows Error Reporting. Evita envio de reportes de crashes a Microsoft.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkSvcSysMain" Content="SysMain/Superfetch"  IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Deshabilita SysMain. Se aplica automaticamente solo si se detecto SSD. En HDD puede reducir rendimiento.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkSvcMaps"    Content="Maps / Geo"          IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Deshabilita MapsBroker y Geolocation. Innecesarios en PCs de escritorio y gaming.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkSvcFax"     Content="Fax / Remote Reg"    IsChecked="True" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Deshabilita Fax y Remote Registry. Innecesarios y pueden ser vectores de ataque.</ToolTip></CheckBox.ToolTip></CheckBox>
                <CheckBox x:Name="chkSvcWSearch" Content="Windows Search (SSD)" IsChecked="False" Margin="0,4,24,4"><CheckBox.ToolTip><ToolTip Background="{DynamicResource BrushElev}" Foreground="{DynamicResource BrushFg2}" FontSize="11">Deshabilita el servicio WSearch (indexado de archivos). Reduce escrituras innecesarias en SSD y consumo de CPU/RAM en segundo plano. No afecta la busqueda manual, solo la indexacion automatica.</ToolTip></CheckBox.ToolTip></CheckBox>
              </WrapPanel>
            </Grid>
          </Border>

        </StackPanel></ScrollViewer>

        <!-- ===== BARRA DE ACCION FIJA (ex Row 2 PROGRESO + Row 3 FOOTER, reubicada aca) =====
             Solo la pestaña Optimizar la tiene; las demas pestañas NO llevan footer. x:Name
             preservados: footerBar, bannerTrial, btnTrialUpgrade, lblPlanSummary, lblPlanWarning,
             lblSpaceFreed, btnSelAll, btnSelNone, btnCancelOpt, btnRun. La barra de progreso y su
             estado ("Listo para optimizar" + %) se removieron (fix 28.3): el progreso vive en el
             overlay. Layout Opcion A: secundarias a la izquierda, "Ejecutar optimizacion" a la derecha. -->
        <Border Grid.Row="1" x:Name="footerBar" BorderThickness="0,1,0,0" Padding="20,10" MinHeight="0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#111111" Offset="0"/>
              <GradientStop Color="#161616" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#3300C8FF" Offset="0"/>
              <GradientStop Color="#00000000" Offset="0.5"/>
              <GradientStop Color="#3300C8FF" Offset="1"/>
            </LinearGradientBrush>
          </Border.BorderBrush>
          <StackPanel>
            <!-- Banner trial (F0.2): visible durante y post-trial -->
            <Border x:Name="bannerTrial" Background="#1A1200" BorderBrush="#3A2800" BorderThickness="1"
                    CornerRadius="5" Padding="10,7" Margin="0,0,0,8" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblTrialText" Grid.Column="0" Text="" FontSize="11"
                           Foreground="#F59E0B" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="btnTrialUpgrade" Grid.Column="1"
                        Content="Activar Pro" Padding="12,5"
                        Background="#2A1800" BorderBrush="#F59E0B" BorderThickness="1"
                        Foreground="#F59E0B" FontSize="11" Cursor="Hand" FontWeight="SemiBold">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="#3A2200"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
            </Border>
            <!-- fix 28.3: la barra de progreso y su estado ("Listo para optimizar" + %) se
                 quitaron de Optimizar — el progreso ahora vive SOLO en el overlay de consola
                 (ProgressService apunta a progressBarConsole). Queda el contador (plan summary) y
                 los botones. -->
            <!-- Plan summary (3.2): N acciones · categorias, actualizado en tiempo real -->
            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="lblPlanSummary" FontSize="11" Foreground="#555555" VerticalAlignment="Center"
                         Text="Nada seleccionado"/>
              <TextBlock x:Name="lblPlanWarning" Grid.Column="1" FontSize="10" Foreground="#F59E0B"
                         VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <!-- Fila principal (Opcion A): acciones secundarias a la izquierda, Ejecutar a la derecha -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnSelAll"     Content="Seleccionar todo"      Style="{StaticResource BtnSec}"    Margin="0,0,8,0"/>
                <Button x:Name="btnSelNone"    Content="Deseleccionar"         Style="{StaticResource BtnSec}"    Margin="0,0,12,0"/>
                <TextBlock x:Name="lblSpaceFreed" Text="" FontSize="11" Foreground="#22C55E" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnCancelOpt"  Content="Detener"               Style="{StaticResource BtnDanger}" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button x:Name="btnRun"        Content="Ejecutar optimizacion" Style="{StaticResource BtnMain}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        </Grid>
      </TabItem>

      <!-- TAB HERRAMIENTAS -->
      <TabItem Header="Herramientas">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="20,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CUADRANTE 1: Liberador de RAM (Row 0, Col 0) -->
            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BrushCard}"
                    CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    Margin="0,0,5,10" Padding="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BrushAccent}" CornerRadius="8,0,0,8"/>
                <StackPanel Grid.Column="1" Margin="14,12">
                  <TextBlock Text="LIBERADOR DE RAM" FontSize="11"
                             FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,8"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap" Margin="0,0,0,12"
                    Text="Comprime los Working Sets de todos los procesos accesibles y vacia la Standby List del kernel. Util en equipos con poca RAM disponible."/>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource BrushSidebar}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="12,12">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="lblRAMTotal" Text="-- GB" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushFg2}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource BrushSidebar}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="12,12">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="EN USO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="lblRAMUsed" Text="-- GB" FontSize="20" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{DynamicResource BrushSidebar}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="12,12">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="LIBRE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="lblRAMFree" Text="-- GB" FontSize="20" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnFreeRAM" Content="Liberar RAM ahora" Style="{StaticResource BtnMain}" Padding="18,8"/>
                    <Border Background="{DynamicResource BrushElev}" CornerRadius="4" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="lblRAMFreeStatus" Text="Listo" FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- CUADRANTE 2: Limpieza de cache (Row 0, Col 1) -->
            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BrushCard}"
                    CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    Margin="5,0,0,10" Padding="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#22C55E" CornerRadius="8,0,0,8"/>
                <StackPanel Grid.Column="1" Margin="14,12">
                  <TextBlock Text="LIMPIEZA PROFUNDA DE CACHE" FontSize="11"
                             FontWeight="SemiBold" Foreground="#22C55E" Margin="0,0,0,8"/>
                  <TextBlock Text="Elimina caches del Explorador (IconCache, thumbcache), reportes de errores WER, logs de CBS/DISM y cache de shaders Direct3D." FontSize="12" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <Border Background="#1A1000" CornerRadius="5" BorderBrush="#3A2500" BorderThickness="1" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock Text="&#x26A0;  El Explorador se detendra y reiniciara automaticamente. La pantalla puede parpadear 2-3 segundos." FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap"/>
                  </Border>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnDeepClean" Content="Limpiar Cache Profunda" Style="{StaticResource BtnMain}" Padding="18,8"/>
                    <Border Background="{DynamicResource BrushElev}" CornerRadius="4" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="lblDeepCleanStatus" Text="Listo" FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- CUADRANTE 3: Benchmark de disco - DESCARTADO (CrystalDiskMark cubre esto). Oculto, sin codigo C#. -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushCard}"
                    CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    Margin="0,0,5,10" Padding="0" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#A855F7" CornerRadius="8,0,0,8"/>
                <StackPanel Grid.Column="1" Margin="14,12">
                  <TextBlock Text="BENCHMARK RAPIDO DE DISCO" FontSize="11"
                             FontWeight="SemiBold" Foreground="#A855F7" Margin="0,0,0,8"/>
                  <TextBlock Text="Mide velocidad de escritura y lectura secuencial con un archivo de 100 MB. Ejecuta antes y despues de optimizar para ver la mejora." FontSize="12" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="btnBenchmark" Content="Ejecutar Benchmark" Style="{StaticResource BtnMain}" Padding="18,8"/>
                    <Border Background="{DynamicResource BrushElev}" CornerRadius="4" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="lblBenchStatus" Text="Listo" FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
                    </Border>
                  </StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource BrushSidebar}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ESCRITURA" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <TextBlock x:Name="lblWriteSpeed" Text="--" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                          <TextBlock Text=" MB/s" FontSize="13" Foreground="{DynamicResource BrushFgDim}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                        </StackPanel>
                        <TextBlock x:Name="lblWriteCompare" Text="" FontSize="11" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource BrushSidebar}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="16,14">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="LECTURA" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <TextBlock x:Name="lblReadSpeed" Text="--" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                          <TextBlock Text=" MB/s" FontSize="13" Foreground="{DynamicResource BrushFgDim}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                        </StackPanel>
                        <TextBlock x:Name="lblReadCompare" Text="" FontSize="11" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>

            <!-- CUADRANTE 4: Mantenimiento automatico (Row 1, ocupa toda la fila tras quitar el benchmark) -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource BrushCard}"
                    CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    Margin="0,0,0,10" Padding="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F59E0B" CornerRadius="8,0,0,8"/>
                <StackPanel Grid.Column="1" Margin="14,12">
                  <TextBlock Text="MANTENIMIENTO AUTOMATICO" FontSize="11"
                             FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Programa la limpieza automatica del sistema. Se ejecuta sin abrir la app."
                               FontSize="12" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="tglMaintenance" Grid.Column="1"
                            Content="Activar" Style="{StaticResource BtnSec}"
                            Padding="16,7" MinWidth="100"/>
                  </Grid>
                  <Border Background="{DynamicResource BrushSidebar}" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}"
                          BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Frecuencia:"
                                 FontSize="12" Foreground="{DynamicResource BrushFgMuted}"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                      <ComboBox x:Name="cboMaintFreq" Grid.Column="1"
                                Style="{StaticResource ComboDark}"
                                SelectedIndex="1">
                        <ComboBoxItem Content="Diario"/>
                        <ComboBoxItem Content="Semanal"/>
                        <ComboBoxItem Content="Al iniciar Windows"/>
                      </ComboBox>
                      <TextBlock Grid.Column="2" Text="Hora:"
                                 FontSize="12" Foreground="{DynamicResource BrushFgMuted}"
                                 VerticalAlignment="Center" Margin="14,0,10,0"/>
                      <ComboBox x:Name="cboMaintHour" Grid.Column="3"
                                Style="{StaticResource ComboDark}"/>
                    </Grid>
                  </Border>
                  <Border Background="{DynamicResource BrushSidebar}" CornerRadius="6" BorderBrush="{DynamicResource BrushBorder}"
                          BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Limpiar:" FontSize="11" Foreground="{DynamicResource BrushFgMuted}" Margin="0,0,0,6"/>
                      <WrapPanel>
                        <CheckBox x:Name="chkMaintTemp"    Content="Temp usuario" IsChecked="True"  Margin="0,2,20,2"/>
                        <CheckBox x:Name="chkMaintRecycle" Content="Papelera"     IsChecked="True"  Margin="0,2,20,2"/>
                        <CheckBox x:Name="chkMaintDNS"     Content="DNS flush"    IsChecked="True"  Margin="0,2,20,2"/>
                        <CheckBox x:Name="chkMaintTRIM"    Content="TRIM (SSD)"   IsChecked="True"  Margin="0,2,0,2"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="lblLastMaint" Text="Ultimo mantenimiento: Nunca"
                                 FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
                      <TextBlock x:Name="lblNextMaint" Text="Proximo: --"
                                 FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Border Background="{DynamicResource BrushElev}" CornerRadius="4" Padding="10,5"
                              Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblMaintStatus" Text="No configurado"
                                   FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
                      </Border>
                      <Button x:Name="btnRunMaintNow" Content="Ejecutar ahora"
                              Style="{StaticResource BtnSec}" Padding="14,7" IsEnabled="False"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>

            <!-- FILA COMPLETA: Procesos pesados (Row 2, ColSpan 2) -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Padding="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#EF4444" CornerRadius="8,0,0,8"/>
                <StackPanel Grid.Column="1" Margin="14,12">
                  <TextBlock Text="PROCESOS PESADOS" FontSize="11"
                             FontWeight="SemiBold" Foreground="#EF4444" Margin="0,0,0,8"/>
                  <Border Background="{DynamicResource BrushSidebar}" CornerRadius="8,8,0,0"
                          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnRefreshProcs" Content="Actualizar"
                                Style="{StaticResource BtnSec}" Padding="12,5" Margin="0,0,8,0"/>
                        <Button x:Name="btnToggleProcTimer" Content="Auto-refresh ON"
                                Style="{StaticResource BtnSec}" Padding="12,5" Margin="0,0,12,0"/>
                        <Border Background="{DynamicResource BrushElev}" CornerRadius="4"
                                Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0">
                          <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="chkShowSysProcs" Content="Mostrar sistema"
                                      FontSize="11" Foreground="{DynamicResource BrushFgMuted}"
                                      Margin="0" IsChecked="False"/>
                          </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BrushElev}" CornerRadius="4"
                                Padding="8,4" VerticalAlignment="Center">
                          <TextBlock x:Name="lblProcsStatus" Text="Sin datos"
                                     FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Background="#0D1F2D" CornerRadius="4"
                                Padding="8,4" Margin="0,0,6,0">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU total: " FontSize="10" Foreground="{DynamicResource BrushFgDim}"/>
                            <TextBlock x:Name="lblProcsCpuTotal" Text="--"
                                       FontSize="10" Foreground="{StaticResource BrushAccent}"/>
                          </StackPanel>
                        </Border>
                        <Border Background="#1A0D2D" CornerRadius="4" Padding="8,4">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Procesos: " FontSize="10" Foreground="{DynamicResource BrushFgDim}"/>
                            <TextBlock x:Name="lblProcsCount" Text="--"
                                       FontSize="10" Foreground="#A855F7"/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Background="{DynamicResource BrushCard}" Padding="14,7"
                          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="85"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="PROCESO"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                      <TextBlock Grid.Column="1" Text="PID"       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                      <TextBlock Grid.Column="2" Text="CPU %"     FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                      <TextBlock Grid.Column="3" Text="RAM"       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                      <TextBlock Grid.Column="4" Text="EMPRESA"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" Margin="8,0,0,0"/>
                      <TextBlock Grid.Column="5" Text="ACCION"    FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border Background="{DynamicResource BrushDeep}" CornerRadius="0,0,8,8" Height="280">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl x:Name="icProcs" Padding="0,2"/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <!-- DISPOSITIVOS CON PROBLEMAS (F1.7) -->
            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource BrushCard}" CornerRadius="8"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    Margin="0,0,0,10" Padding="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F59E0B" CornerRadius="8,0,0,8"/>
                <StackPanel Grid.Column="1" Margin="14,12">
                  <TextBlock Text="DISPOSITIVOS CON PROBLEMAS" FontSize="11"
                             FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,0,8"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource BrushFgMuted}"
                             TextWrapping="Wrap" Margin="0,0,0,10"
                             Text="Muestra dispositivos que no responden correctamente segun el Administrador de dispositivos. Solo lectura — no modifica drivers."/>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="btnScanDevices" Content="Escanear dispositivos"
                              Style="{StaticResource BtnMain}" Padding="14,7"/>
                      <Border Background="{DynamicResource BrushElev}" CornerRadius="4"
                              Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblDeviceProblemsStatus" Text="Listo"
                                   FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
                      </Border>
                    </StackPanel>
                    <Button x:Name="btnOpenDevMgmt" Grid.Column="1"
                            Content="Administrador de dispositivos"
                            Style="{StaticResource BtnSec}" Padding="14,7"/>
                  </Grid>
                  <Border Background="{DynamicResource BrushCard}" Padding="8,6"
                          BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="80"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="DISPOSITIVO" FontSize="10"
                                 FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                      <TextBlock Grid.Column="1" Text="ESTADO" FontSize="10"
                                 FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                      <TextBlock Grid.Column="2" Text="CODIGO" FontSize="10"
                                 FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"
                                 HorizontalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border Background="{DynamicResource BrushDeep}" CornerRadius="0,0,8,8" Height="180">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl x:Name="icDeviceProblems" Padding="0,2"/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <!-- FILA COMPLETA: Limpieza del Driver Store (Row 4, ColSpan 2) - movida desde Tuning -->
            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource BrushCard}" CornerRadius="8"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    Margin="0,0,0,10" Padding="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#06B6D4" CornerRadius="8,0,0,8"/>
                <StackPanel Grid.Column="1" Margin="14,12">
                  <TextBlock Text="LIMPIEZA DEL DRIVER STORE" FontSize="11" FontWeight="SemiBold"
                             Foreground="#06B6D4" Margin="0,0,0,8"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap" Margin="0,0,0,10"
                    Text="Detecta versiones antiguas del Driver Store de Windows (paquetes oem*.inf duplicados por el mismo driver con multiples versiones). Solo muestra duplicados - los drivers sin copia mas nueva no aparecen. Requiere hacer backup antes de eliminar."/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="btnScanDrvStore" Content="Escanear drivers" Style="{StaticResource BtnSec}"
                            Padding="14,7" Margin="0,0,8,0"/>
                    <Button x:Name="btnDriverBackup" Content="Exportar backup de drivers"
                            Style="{StaticResource BtnSec}" Padding="14,7" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="btnDriverDelete" Content="Eliminar seleccionados"
                            Style="{StaticResource BtnDanger}" Padding="14,7" IsEnabled="False"/>
                  </StackPanel>
                  <TextBlock x:Name="lblDriverStatus" FontSize="11" Margin="0,0,0,8"/>
                  <ScrollViewer x:Name="drvListScroll" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                Visibility="Collapsed">
                    <ItemsControl x:Name="icDrvStore"/>
                  </ScrollViewer>
                </StackPanel>
              </Grid>
            </Border>

          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- TAB INFO DEL SISTEMA -->
      <!-- TAB HOME / DASHBOARD (fix 30): nueva entrada de la app. Reemplaza a Info del sistema
           (ocupa su mismo indice de tab). El monitor en vivo alimenta los medidores circulares;
           el score alimenta la malla de salud; hardware+componentes viven en el overlay System
           Info (systemInfoOverlay). -->
      <TabItem Header="Home">
        <!-- fix 31: root Grid (no ScrollViewer) para aprovechar el alto -> fila inferior * que
             estira la malla/ultima-optimizacion sin deformar. -->
        <Grid Margin="24,18,24,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- bienvenida -->
            <RowDefinition Height="Auto"/>   <!-- medidores -->
            <RowDefinition Height="*"/>      <!-- cuadrante inferior (estira) -->
          </Grid.RowDefinitions>

          <!-- a) BIENVENIDA -->
          <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock FontSize="25" FontWeight="Bold" Foreground="{DynamicResource BrushFg1}">
                <Run Text="Bienvenido a "/><Run Text="Win" FontWeight="Regular" Foreground="{StaticResource BrushAccent}"/><Run Text="Boost" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
              </TextBlock>
              <TextBlock Text="Optimizacion, rendimiento y control total de tu PC" FontSize="13"
                         Foreground="{DynamicResource BrushFgMuted}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="btnHomeSysInfo" Content="System Info" Style="{StaticResource BtnGlossyDark}" Margin="0,0,10,0"/>
              <Button x:Name="btnHomeOptimize" Content="Optimizar ahora" Style="{StaticResource BtnGlossyCyan}"/>
            </StackPanel>
          </Grid>

          <!-- b) MEDIDORES CPU / RAM / GPU (gauge custom: track + arco + % al centro; sin modelo) -->
          <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- CPU -->
            <Border Grid.Column="0" Style="{StaticResource CardGlossy}">
              <Grid>
                <Border CornerRadius="10" IsHitTestVisible="False">
                  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1AFFFFFF" Offset="0"/><GradientStop Color="#0DFFFFFF" Offset="0.12"/><GradientStop Color="#00FFFFFF" Offset="0.42"/></LinearGradientBrush></Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,18">
                  <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Ellipse Width="96" Height="96" Stroke="#2A2A2A" StrokeThickness="9"/>
                    <Path x:Name="arcCpu" Stroke="{StaticResource BrushAccent}" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Path.Data><PathGeometry><PathFigure StartPoint="48,4.5"><ArcSegment x:Name="segCpu" Point="48,4.5" Size="43.5,43.5" SweepDirection="Clockwise" IsLargeArc="False"/></PathFigure></PathGeometry></Path.Data>
                    </Path>
                    <TextBlock x:Name="lblGaugeCpu" Text="0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushFg1}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <!-- RAM -->
            <Border Grid.Column="2" Style="{StaticResource CardGlossy}">
              <Grid>
                <Border CornerRadius="10" IsHitTestVisible="False">
                  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1AFFFFFF" Offset="0"/><GradientStop Color="#0DFFFFFF" Offset="0.12"/><GradientStop Color="#00FFFFFF" Offset="0.42"/></LinearGradientBrush></Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,18">
                  <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Ellipse Width="96" Height="96" Stroke="#2A2A2A" StrokeThickness="9"/>
                    <Path x:Name="arcRam" Stroke="{StaticResource BrushAccent}" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Path.Data><PathGeometry><PathFigure StartPoint="48,4.5"><ArcSegment x:Name="segRam" Point="48,4.5" Size="43.5,43.5" SweepDirection="Clockwise" IsLargeArc="False"/></PathFigure></PathGeometry></Path.Data>
                    </Path>
                    <TextBlock x:Name="lblGaugeRam" Text="0%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushFg1}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="RAM" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <!-- GPU -->
            <Border Grid.Column="4" Style="{StaticResource CardGlossy}">
              <Grid>
                <Border CornerRadius="10" IsHitTestVisible="False">
                  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1AFFFFFF" Offset="0"/><GradientStop Color="#0DFFFFFF" Offset="0.12"/><GradientStop Color="#00FFFFFF" Offset="0.42"/></LinearGradientBrush></Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,18">
                  <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Ellipse Width="96" Height="96" Stroke="#2A2A2A" StrokeThickness="9"/>
                    <Path x:Name="arcGpu" Stroke="{StaticResource BrushAccent}" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Path.Data><PathGeometry><PathFigure StartPoint="48,4.5"><ArcSegment x:Name="segGpu" Point="48,4.5" Size="43.5,43.5" SweepDirection="Clockwise" IsLargeArc="False"/></PathFigure></PathGeometry></Path.Data>
                    </Path>
                    <TextBlock x:Name="lblGaugeGpu" Text="--" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushFg1}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="GPU" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- c) CUADRANTE INFERIOR: malla de salud (2fr) | ultima optimizacion (1fr). Estira (Row *). -->
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- IZQUIERDA: MALLA DE SALUD 2x2 -->
            <Border Grid.Column="0" Style="{StaticResource CardGlossy}">
              <Grid Margin="16,14">
                <Border CornerRadius="10" IsHitTestVisible="False" VerticalAlignment="Top" Height="60" Margin="-16,-14,-16,0">
                  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#16FFFFFF" Offset="0"/><GradientStop Color="#0AFFFFFF" Offset="0.3"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="SALUD" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <TextBlock x:Name="lblHomeScore" Text="--" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Center"/>
                      <TextBlock Text="%" FontSize="14" Foreground="{DynamicResource BrushFgMuted}" VerticalAlignment="Bottom" Margin="1,0,10,4"/>
                      <TextBlock x:Name="lblHomeScoreLabel" Text="" FontSize="11" Foreground="{DynamicResource BrushFgMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="btnRecalcScore" Grid.Column="1" Content="Recalcular" Style="{StaticResource BtnSec}" Padding="12,5" FontSize="11"/>
                  </Grid>

                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <!-- Rendimiento (verde) -->
                    <Border Grid.Column="0" Grid.Row="0" Margin="0,0,6,6" CornerRadius="10" BorderThickness="1" BorderBrush="#4022C55E">
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#18231B" Offset="0"/><GradientStop Color="#141414" Offset="1"/></LinearGradientBrush></Border.Background>
                      <Grid>
                        <Border CornerRadius="10" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#14FFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="0.16"/><GradientStop Color="#00FFFFFF" Offset="0.5"/></LinearGradientBrush></Border.Background></Border>
                        <StackPanel Margin="13,11" VerticalAlignment="Center">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,7,0"/>
                              <TextBlock Text="Rendimiento" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                              <TextBlock x:Name="lblHomeRendStatus" Text="--" FontSize="9.5" FontWeight="SemiBold" Foreground="#22C55E"/>
                            </Border>
                          </Grid>
                          <TextBlock x:Name="lblHomeRendFrac" Text="0/0" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource BrushFg1}" Margin="0,7,0,2"/>
                          <TextBlock x:Name="lblHomeRendInsight" Text="" FontSize="10.5" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- Privacidad (ambar) -->
                    <Border Grid.Column="1" Grid.Row="0" Margin="6,0,0,6" CornerRadius="10" BorderThickness="1" BorderBrush="#40F59E0B">
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#241E15" Offset="0"/><GradientStop Color="#141414" Offset="1"/></LinearGradientBrush></Border.Background>
                      <Grid>
                        <Border CornerRadius="10" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#14FFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="0.16"/><GradientStop Color="#00FFFFFF" Offset="0.5"/></LinearGradientBrush></Border.Background></Border>
                        <StackPanel Margin="13,11" VerticalAlignment="Center">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,7,0"/>
                              <TextBlock Text="Privacidad" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                              <TextBlock x:Name="lblHomePrivStatus" Text="--" FontSize="9.5" FontWeight="SemiBold" Foreground="#F59E0B"/>
                            </Border>
                          </Grid>
                          <TextBlock x:Name="lblHomePrivFrac" Text="0/0" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource BrushFg1}" Margin="0,7,0,2"/>
                          <TextBlock x:Name="lblHomePrivInsight" Text="" FontSize="10.5" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- Red (cyan) -->
                    <Border Grid.Column="0" Grid.Row="1" Margin="0,6,6,0" CornerRadius="10" BorderThickness="1" BorderBrush="#4000C8FF">
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#15222A" Offset="0"/><GradientStop Color="#141414" Offset="1"/></LinearGradientBrush></Border.Background>
                      <Grid>
                        <Border CornerRadius="10" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#14FFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="0.16"/><GradientStop Color="#00FFFFFF" Offset="0.5"/></LinearGradientBrush></Border.Background></Border>
                        <StackPanel Margin="13,11" VerticalAlignment="Center">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#00C8FF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                              <TextBlock Text="Red" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                              <TextBlock x:Name="lblHomeRedStatus" Text="--" FontSize="9.5" FontWeight="SemiBold" Foreground="#00C8FF"/>
                            </Border>
                          </Grid>
                          <TextBlock x:Name="lblHomeRedFrac" Text="0/0" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource BrushFg1}" Margin="0,7,0,2"/>
                          <TextBlock x:Name="lblHomeRedInsight" Text="" FontSize="10.5" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- Servicios (violeta) -->
                    <Border Grid.Column="1" Grid.Row="1" Margin="6,6,0,0" CornerRadius="10" BorderThickness="1" BorderBrush="#40A855F7">
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1F1826" Offset="0"/><GradientStop Color="#141414" Offset="1"/></LinearGradientBrush></Border.Background>
                      <Grid>
                        <Border CornerRadius="10" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#14FFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="0.16"/><GradientStop Color="#00FFFFFF" Offset="0.5"/></LinearGradientBrush></Border.Background></Border>
                        <StackPanel Margin="13,11" VerticalAlignment="Center">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#A855F7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                              <TextBlock Text="Servicios" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                              <TextBlock x:Name="lblHomeServStatus" Text="--" FontSize="9.5" FontWeight="SemiBold" Foreground="#A855F7"/>
                            </Border>
                          </Grid>
                          <TextBlock x:Name="lblHomeServFrac" Text="0/0" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource BrushFg1}" Margin="0,7,0,2"/>
                          <TextBlock x:Name="lblHomeServInsight" Text="" FontSize="10.5" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </Grid>
            </Border>

            <!-- DERECHA: ULTIMA OPTIMIZACION -->
            <Border Grid.Column="2" CornerRadius="10" BorderThickness="1" BorderBrush="#4000C8FF">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#15242C" Offset="0"/><GradientStop Color="#121616" Offset="1"/></LinearGradientBrush></Border.Background>
              <Grid>
                <Border CornerRadius="10" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#18FFFFFF" Offset="0"/><GradientStop Color="#0AFFFFFF" Offset="0.12"/><GradientStop Color="#00FFFFFF" Offset="0.4"/></LinearGradientBrush></Border.Background></Border>
                <Grid Margin="16,14">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="ULTIMA OPTIMIZACION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" Margin="0,0,0,10"/>
                  <!-- estado con datos -->
                  <StackPanel Grid.Row="1" x:Name="panelHomeLastData" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="lblHomeLastWhen" Text="" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushFg1}" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <TextBlock x:Name="lblHomeLastFreed" Text="0 MB" FontSize="19" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Bottom"/>
                      <TextBlock Text=" liberados" FontSize="11" Foreground="{DynamicResource BrushFgMuted}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <TextBlock x:Name="lblHomeLastScore" Text="+0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Bottom"/>
                      <TextBlock Text=" puntos de salud" FontSize="11" Foreground="{DynamicResource BrushFgMuted}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="lblHomeLastActions" Text="0" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BrushFg1}" VerticalAlignment="Bottom"/>
                      <TextBlock Text=" acciones" FontSize="11" Foreground="{DynamicResource BrushFgMuted}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                    </StackPanel>
                  </StackPanel>
                  <!-- estado vacio -->
                  <StackPanel Grid.Row="1" x:Name="panelHomeLastEmpty" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Todavia no optimizaste" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushFg2}" TextWrapping="Wrap"/>
                    <TextBlock Text="Optimiza ahora para ver tus resultados aca." FontSize="11" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button Grid.Row="2" x:Name="btnHomeViewHistory" Content="Ver historial" Style="{StaticResource BtnSec}" Padding="12,5" FontSize="11" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </Grid>
              </Grid>
            </Border>

          </Grid>
        </Grid>
      </TabItem>

      <!-- TAB ARRANQUE -->
      <TabItem Header="Arranque">
        <Grid Margin="20,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" FontSize="12" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap" Margin="0,0,0,12"
            Text="Programas que se inician con Windows (HKCU, HKLM y carpeta Startup). Deshabilitar no borra el programa, solo evita que arranque automaticamente."/>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnRefreshStartup" Content="Actualizar lista" Style="{StaticResource BtnSec}" Padding="14,6" Margin="0,0,8,0"/>
            <Border Background="{DynamicResource BrushElev}" CornerRadius="4" Padding="10,5" Margin="4,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="lblStartupStatus" Text="Cargando..." FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
            </Border>
          </StackPanel>

          <Border Grid.Row="2" Background="{DynamicResource BrushDeep}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource BrushCard}" CornerRadius="8,8,0,0" Padding="12,8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="95"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="ESTADO"  FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="1" Text="NOMBRE"  FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="2" Text="ORIGEN"  FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="3" Text="RUTA"    FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" Margin="8,0,0,0"/>
                  <TextBlock Grid.Column="4" Text="ACCION"  FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icStartup" Padding="0,4"/>
              </ScrollViewer>
            </Grid>
          </Border>

          <TextBlock Grid.Row="3" x:Name="lblStartupCount" Text="" FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,8,0,0"/>
        </Grid>
      </TabItem>

      <!-- TAB BLOATWARE (Modulo 4B) -->
      <TabItem Header="Bloatware">
        <Grid Margin="20,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" FontSize="12" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap" Margin="0,0,0,12"
            Text="Apps preinstaladas y bloatware detectado en este equipo. Podes desinstalarlas de forma segura. Las marcadas como 'Precaucion' pueden afectar funciones de Windows."/>

          <!-- Stats de deteccion: cards individuales con hover -->
          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStat}">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="lblBloatCount" Text="--" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center"/>
                <TextBlock Text="detectados" FontSize="10" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStatGreen}">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="lblBloatMB" Text="--" FontSize="22" FontWeight="Bold"
                           Foreground="#22C55E" HorizontalAlignment="Center"/>
                <TextBlock Text="MB estimados" FontSize="10" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardStatGreen}">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="lblBloatSafe" Text="--" FontSize="22" FontWeight="Bold"
                           Foreground="#22C55E" HorizontalAlignment="Center"/>
                <TextBlock Text="seguros" FontSize="10" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource CardStatAmber}">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="lblBloatCaution" Text="--" FontSize="22" FontWeight="Bold"
                           Foreground="#F59E0B" HorizontalAlignment="Center"/>
                <TextBlock Text="precaucion" FontSize="10" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="8" VerticalAlignment="Center">
              <Border Background="{DynamicResource BrushElev}" CornerRadius="4" Padding="10,5">
                <TextBlock x:Name="lblBloatStatus" Text="Sin escanear"
                           FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
              </Border>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="btnScanBloat" Content="Actualizar lista"
                      Style="{StaticResource BtnMain}" Padding="16,7" Margin="0,0,8,0"/>
              <Button x:Name="btnBloatSelAll"  Content="Seleccionar seguros"
                      Style="{StaticResource BtnSec}" Padding="12,7" Margin="0,0,8,0"/>
              <Button x:Name="btnBloatSelNone" Content="Deseleccionar"
                      Style="{StaticResource BtnSec}" Padding="12,7" Margin="0,0,8,0"/>
              <Border Background="{DynamicResource BrushCtrl}" CornerRadius="5" BorderBrush="{DynamicResource BrushBorder}"
                      BorderThickness="1" Padding="4,2" VerticalAlignment="Center">
                <ComboBox x:Name="cboBloatFilter"
                          Style="{StaticResource ComboDark}"
                          Width="130" SelectedIndex="0">
                  <ComboBoxItem Content="Todas las categorias"/>
                  <ComboBoxItem Content="Juegos"/>
                  <ComboBoxItem Content="Comunicacion"/>
                  <ComboBoxItem Content="Telemetria"/>
                  <ComboBoxItem Content="OEM"/>
                  <ComboBoxItem Content="Utilidades"/>
                </ComboBox>
              </Border>
            </StackPanel>
            <Button x:Name="btnRemoveBloat" Grid.Column="1"
                    Content="Desinstalar seleccionados"
                    Style="{StaticResource BtnDanger}"
                    IsEnabled="False" Padding="16,7">
              <Button.ToolTip>
                <ToolTip Background="{DynamicResource BrushElev}" BorderBrush="#EF4444"
                         Foreground="{DynamicResource BrushFg2}" FontSize="11">
                  Desinstala las apps seleccionadas. Esta accion no se puede deshacer facilmente.
                </ToolTip>
              </Button.ToolTip>
            </Button>
          </Grid>

          <Border Grid.Row="3" Background="{DynamicResource BrushDeep}" CornerRadius="8"
                  BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource BrushCard}" CornerRadius="8,8,0,0"
                      Padding="14,8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="80"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text=""         FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="1" Text="NOMBRE"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="2" Text="CATEGORIA" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="3" Text="METODO"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="4" Text="ESPACIO"  FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="5" Text="RIESGO"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icBloat" Padding="0,4"/>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Row="4" Background="{DynamicResource BrushSidebar}" CornerRadius="6"
                  BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,8" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="lblBloatSelected" Grid.Column="0"
                         Text="0 apps seleccionadas  |  0 MB estimados"
                         FontSize="11" Foreground="{DynamicResource BrushFgDim}" VerticalAlignment="Center"/>
              <TextBlock x:Name="lblBloatWinget" Grid.Column="1"
                         Text="" FontSize="10" Foreground="{DynamicResource BrushFgDim}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

        </Grid>
      </TabItem>

      <!-- TAB CONSOLA ELIMINADO (fix 27): la Consola dejo de ser pestaña y paso a un OVERLAY
           modal (consoleOverlay, definido al final del grid raiz). Sus controles (rtbLog,
           logScroll, btnClearLog, btnExportLog, btnExportHTML, lblLogStatus, progressBarConsole,
           lblProgressConsole, lblPctConsole) se movieron TAL CUAL al overlay conservando sus
           x:Name, asi el AppLogger, ExportConsoleLog, ExportHtmlReportAsync y el ProgressService
           siguen funcionando sin cambios. Al quitar esta TabItem los indices posteriores bajaron
           1: Historial 6->5, Ajustes 7->6, Licencia 8->7, Tuning 9->8 (recableado en el .cs). -->

      <!-- TAB HISTORIAL -->
      <TabItem Header="Historial">
        <Grid Margin="20,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock FontSize="12" Foreground="{DynamicResource BrushFgMuted}" TextWrapping="Wrap" Margin="0,0,0,12"
              Text="Cada vez que ejecutas una optimizacion se guarda un punto de restauracion completo. Podes revertir cualquier sesion anterior de forma individual."/>

            <!-- 4 cards de estadisticas con hover -->
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStat}">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock x:Name="lblHistTotalSessions" Text="--"
                             FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Sesiones" FontSize="10" Foreground="{DynamicResource BrushFgDim}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource CardStatGreen}">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock x:Name="lblHistTotalMB" Text="--"
                             FontSize="22" FontWeight="Bold" Foreground="#22C55E"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="MB liberados" FontSize="10" Foreground="{DynamicResource BrushFgDim}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource CardStatAmber}">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock x:Name="lblHistAvgImprovement" Text="--"
                             FontSize="22" FontWeight="Bold" Foreground="#F59E0B"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="pts mejora / sesion" FontSize="10" Foreground="{DynamicResource BrushFgDim}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="6" Style="{StaticResource CardStatPurple}">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock x:Name="lblHistDaysSince" Text="--"
                             FontSize="22" FontWeight="Bold" Foreground="#A855F7"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="dias de uso" FontSize="10" Foreground="{DynamicResource BrushFgDim}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="SCORE POR SESION (ultimas 8)" FontSize="10"
                           FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" Margin="0,0,0,10"/>
                <Canvas x:Name="icScoreHistory" Height="60" Background="Transparent"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="btnRefreshHistory" Content="Actualizar" Style="{StaticResource BtnSec}" Padding="14,6" Margin="0,0,8,0"/>
              <Button x:Name="btnOpenBackupFolder" Content="Abrir carpeta" Style="{StaticResource BtnSec}" Padding="14,6" Margin="0,0,16,0"/>
              <Border Background="{DynamicResource BrushElev}" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                <TextBlock x:Name="lblHistoryStatus" Text="Cargando..." FontSize="11" Foreground="{DynamicResource BrushFgDim}"/>
              </Border>
            </StackPanel>
            <Button x:Name="btnRevertLast" Grid.Column="1"
                    Content="Revertir ultima sesion"
                    Style="{StaticResource BtnDanger}" Padding="16,6">
              <Button.ToolTip>
                <ToolTip Background="{DynamicResource BrushElev}" BorderBrush="#EF4444" Foreground="{DynamicResource BrushFg2}" FontSize="11">
                  Revierte automaticamente la sesion mas reciente guardada.
                </ToolTip>
              </Button.ToolTip>
            </Button>
          </Grid>

          <Border Grid.Row="2" Background="{DynamicResource BrushDeep}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource BrushCard}" CornerRadius="8,8,0,0"
                      Padding="14,8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="FECHA"    FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="1" Text="PRESET"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="2" Text="ACCIONES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="3" Text="LIBERADO"  FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}"/>
                  <TextBlock Grid.Column="4" Text="ESTADO"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" Margin="8,0,0,0"/>
                  <TextBlock Grid.Column="5" Text="ACCION"   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icHistory" Padding="0,4"/>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Row="3" Background="#0F0F0F" CornerRadius="8"
                  BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,10,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="80"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource BrushCard}" CornerRadius="8,8,0,0"
                      Padding="12,6" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="LOG DE RESTAURACION" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrushFgDim}" VerticalAlignment="Center"/>
                  <Border x:Name="badgeRestoreStatus" Background="{DynamicResource BrushElev}" CornerRadius="4"
                          Padding="8,2" Margin="12,0,0,0">
                    <TextBlock x:Name="lblRestoreLog" Text="Sin actividad"
                               FontSize="10" Foreground="{DynamicResource BrushFgDim}"/>
                  </Border>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" x:Name="restoreLogScroll" VerticalScrollBarVisibility="Auto">
                <RichTextBox x:Name="rtbRestoreLog" Background="Transparent"
                             FontFamily="Consolas" FontSize="11" BorderThickness="0"
                             IsReadOnly="True" Padding="12,8" IsDocumentEnabled="True"/>
              </ScrollViewer>
            </Grid>
          </Border>

        </Grid>
      </TabItem>

      <!-- TAB AJUSTES -->
      <TabItem Header="Ajustes">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,20,24,20">

            <!-- === APARIENCIA === -->
            <TextBlock Text="APARIENCIA" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushFgDim}" Margin="0,0,0,10"/>
            <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Padding="20,16" Margin="0,0,0,20">
              <StackPanel>

                <!-- Tema -->
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Tema de la aplicacion" FontSize="13"
                               Foreground="{DynamicResource BrushFg2}" FontWeight="SemiBold"/>
                    <TextBlock Text="Mas temas proximamente"
                               FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <ComboBox x:Name="cboTheme" Grid.Column="1"
                            Style="{StaticResource ComboDark}"
                            Width="160" IsEnabled="False" SelectedIndex="0">
                    <ComboBoxItem Content="Oscuro"/>
                  </ComboBox>
                </Grid>

                <Border Background="#222222" Height="1" Margin="0,0,0,16"/>

                <!-- Idioma -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Idioma" FontSize="13"
                               Foreground="{DynamicResource BrushFg2}" FontWeight="SemiBold"/>
                    <TextBlock Text="Proximamente: ingles, portugues y mas"
                               FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <ComboBox x:Name="cboLanguage" Grid.Column="1"
                            Style="{StaticResource ComboDark}"
                            Width="160" IsEnabled="False" SelectedIndex="0">
                    <ComboBoxItem Content="Espanol"/>
                    <ComboBoxItem Content="English (proximamente)"/>
                    <ComboBoxItem Content="Portugues (proximamente)"/>
                  </ComboBox>
                </Grid>

              </StackPanel>
            </Border>

            <!-- === COMPORTAMIENTO === -->
            <TextBlock Text="COMPORTAMIENTO" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushFgDim}" Margin="0,0,0,10"/>
            <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Padding="20,16" Margin="0,0,0,20">
              <StackPanel>

                <!-- Al cerrar la ventana -->
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Al cerrar la ventana" FontSize="13"
                               Foreground="{DynamicResource BrushFg2}" FontWeight="SemiBold"/>
                    <TextBlock Text="Que hace la app al presionar la X"
                               FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <ComboBox x:Name="cboCloseAction" Grid.Column="1"
                            Style="{StaticResource ComboDark}"
                            Width="160" SelectedIndex="0">
                    <ComboBoxItem Content="Cerrar la app"/>
                    <ComboBoxItem Content="Minimizar a bandeja"/>
                  </ComboBox>
                </Grid>

                <Border Background="#222222" Height="1" Margin="0,0,0,16"/>

                <!-- Splash screen -->
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Splash screen al iniciar" FontSize="13"
                               Foreground="{DynamicResource BrushFg2}" FontWeight="SemiBold"/>
                    <TextBlock Text="Pantalla de bienvenida al abrir la app"
                               FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <CheckBox x:Name="chkShowSplash" Grid.Column="1"
                            IsChecked="True" VerticalAlignment="Center"/>
                </Grid>

                <Border Background="#222222" Height="1" Margin="0,0,0,16"/>

                <!-- Auto-refresh procesos -->
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Intervalo de procesos" FontSize="13"
                               Foreground="{DynamicResource BrushFg2}" FontWeight="SemiBold"/>
                    <TextBlock Text="Frecuencia de actualizacion en Herramientas"
                               FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <ComboBox x:Name="cboProcRefresh" Grid.Column="1"
                            Style="{StaticResource ComboDark}"
                            Width="160" SelectedIndex="1">
                    <ComboBoxItem Content="Cada 1 segundo"/>
                    <ComboBoxItem Content="Cada 3 segundos"/>
                    <ComboBoxItem Content="Cada 5 segundos"/>
                    <ComboBoxItem Content="Cada 10 segundos"/>
                  </ComboBox>
                </Grid>

                <Border Background="#222222" Height="1" Margin="0,0,0,16"/>

                <!-- Ejecutar al iniciar Windows -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Iniciar con Windows" FontSize="13"
                               Foreground="{DynamicResource BrushFg2}" FontWeight="SemiBold"/>
                    <TextBlock Text="Agregar WinBoost al inicio de Windows"
                               FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <CheckBox x:Name="chkRunAtStartup" Grid.Column="1"
                            IsChecked="False" VerticalAlignment="Center"/>
                </Grid>

              </StackPanel>
            </Border>

            <!-- === MANTENIMIENTO Y BACKUP === -->
            <TextBlock Text="MANTENIMIENTO Y BACKUP" FontSize="10"
                       FontWeight="SemiBold" Foreground="{DynamicResource BrushFgDim}" Margin="0,0,0,10"/>
            <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Padding="20,16" Margin="0,0,0,20">
              <StackPanel>

                <!-- Ruta de backups -->
                <TextBlock Text="Ruta de sesiones de backup" FontSize="13"
                           Foreground="{DynamicResource BrushFg2}" FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Donde se guardan los puntos de restauracion"
                           FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource BrushElev}" CornerRadius="6"
                          BorderBrush="#3A3A3A" BorderThickness="1"
                          Padding="10,6" Margin="0,0,8,0">
                    <TextBlock x:Name="lblBackupPath" Text=""
                               FontSize="11" Foreground="{DynamicResource BrushFgMuted}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                  </Border>
                  <Button x:Name="btnChangeBackupPath" Grid.Column="1"
                          Content="Cambiar" Style="{StaticResource BtnSec}"
                          Padding="12,6"/>
                </Grid>

                <Border Background="#222222" Height="1" Margin="0,0,0,16"/>

                <!-- Retencion de backups -->
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Retener backups por" FontSize="13"
                               Foreground="{DynamicResource BrushFg2}" FontWeight="SemiBold"/>
                    <TextBlock Text="Sesiones mas antiguas se eliminan automaticamente"
                               FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <ComboBox x:Name="cboBackupRetention" Grid.Column="1"
                            Style="{StaticResource ComboDark}"
                            Width="160" SelectedIndex="2">
                    <ComboBoxItem Content="7 dias"/>
                    <ComboBoxItem Content="14 dias"/>
                    <ComboBoxItem Content="30 dias (por defecto)"/>
                    <ComboBoxItem Content="60 dias"/>
                    <ComboBoxItem Content="Ilimitado"/>
                  </ComboBox>
                </Grid>

                <Border Background="#222222" Height="1" Margin="0,0,0,16"/>

                <!-- Abrir carpeta de backups -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Carpeta de backups" FontSize="13"
                               Foreground="{DynamicResource BrushFg2}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblBackupCount" Text="Calculando..."
                               FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button x:Name="btnOpenBackups" Grid.Column="1"
                          Content="Abrir carpeta" Style="{StaticResource BtnSec}"
                          Padding="12,6"/>
                </Grid>

              </StackPanel>
            </Border>

            <!-- === ACERCA DE === -->
            <TextBlock Text="ACERCA DE" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushFgDim}" Margin="0,0,0,10"/>
            <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Padding="20,16" Margin="0,0,0,20">
              <StackPanel>

                <!-- Info version -->
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="WinBoost" FontSize="16"
                                 FontWeight="Bold" Foreground="{DynamicResource BrushFg1}"/>
                      <Border Background="{DynamicResource BrushCtrl}" CornerRadius="4"
                              Padding="6,2" Margin="8,0,0,0"
                              VerticalAlignment="Center">
                        <TextBlock x:Name="lblVersionAbout" Text=""
                                   FontSize="10" Foreground="{StaticResource BrushAccent}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="Optimizador de rendimiento para Windows 10/11"
                               FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button x:Name="btnCheckUpdatesSettings" Grid.Column="1"
                          Content="Buscar updates" Style="{StaticResource BtnSec}"
                          Padding="12,6" VerticalAlignment="Center"/>
                </Grid>

                <Border Background="#222222" Height="1" Margin="0,0,0,16"/>

                <!-- Stats de uso -->
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="lblStatsSessions" Text="0"
                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="sesiones" FontSize="10"
                               Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="lblStatsMB" Text="0"
                               FontSize="22" FontWeight="Bold" Foreground="#22C55E"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="MB liberados" FontSize="10"
                               Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="lblStatsScore" Text="--"
                               FontSize="22" FontWeight="Bold" Foreground="#F59E0B"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="mejor score" FontSize="10"
                               Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock x:Name="lblStatsDays" Text="0"
                               FontSize="22" FontWeight="Bold" Foreground="#A855F7"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="dias de uso" FontSize="10"
                               Foreground="{DynamicResource BrushFgDim}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <Border Background="#222222" Height="1" Margin="0,0,0,16"/>

                <!-- Reset settings -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Restablecer configuracion"
                               FontSize="13" Foreground="{DynamicResource BrushFg2}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Vuelve todos los ajustes a sus valores por defecto"
                               FontSize="11" Foreground="{DynamicResource BrushFgDim}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button x:Name="btnResetSettings" Grid.Column="1"
                          Content="Restablecer" Style="{StaticResource BtnDanger}"
                          Padding="12,6" VerticalAlignment="Center"/>
                </Grid>

              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- TAB LICENCIA (Modulo 12C) -->
      <TabItem Header="Licencia">
        <ScrollViewer Margin="20,16" VerticalScrollBarVisibility="Auto"><StackPanel>

          <!-- Estado actual -->
          <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1" Padding="16,14" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock x:Name="lblLicenseStatus" Text="Version gratuita activa"
                         FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushFgMuted}"
                         Margin="0,0,0,6"/>
              <TextBlock Text="Activa tu licencia para desbloquear tweaks avanzados, mantenimiento automatico y exportacion de reportes."
                         FontSize="12" Foreground="{DynamicResource BrushFgDim}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Hardware ID -->
          <TextBlock Text="HARDWARE ID" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushFgDim}" Margin="0,0,0,8"/>
          <Border Background="{DynamicResource BrushCard}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="ID unico de este equipo. Necesario para generar tu clave de activacion."
