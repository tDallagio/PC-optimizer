              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Obtener licencia Pro" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4"/>
                <TextBlock Text="Desbloquea todas las funciones. Licencia de por vida para este equipo."
