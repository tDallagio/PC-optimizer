              </Grid>
              <Border Background="{DynamicResource BrushSidebar}" CornerRadius="6"
                      BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="12,8">
                <TextBlock x:Name="lblActivationResult" Text="Ingresa tu clave y presiona Activar."
