<Project>
  <!--
    Publish profile para la distribucion de WinBoost (C#).
    Uso: dotnet publish src-csharp\WinBoost\WinBoost.csproj -c Release ^
           -p:PublishProfile=win-x64-selfcontained
    (o via src-csharp\Publish-CSharp.ps1, que ademas arma el instalador)

    Self-contained + single-file: el usuario baja un .exe y lo corre sin tener
    .NET instalado. IncludeNativeLibrariesForSelfExtract=true embebe las DLLs
    nativas de WPF (wpfgfx_cor3.dll, etc.) DENTRO del .exe; WPF las extrae a un
    directorio temporal de bundle en el primer arranque de cada version (esto es
    una particularidad conocida de WPF + single-file, no un error de config: WPF
    no puede cargar sus DLLs nativas directo desde la memoria del single-file).
    EnableCompressionInSingleFile reduce el tamano de descarga a costa de un
    descomprimido extra en el primer arranque (aceptable para un instalador).
    PublishReadyToRun queda OFF: para WPF con single-file duplica el tamano del
    exe (JIT + codigo nativo) por una mejora de arranque en frio marginal en una
    app que el usuario abre ocasionalmente, no en cada boot.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContainedDeploymentUseAppHost>true</SelfContainedDeploymentUseAppHost>
  </PropertyGroup>
</Project>
