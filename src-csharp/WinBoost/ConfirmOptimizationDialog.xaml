<Window x:Class="WinBoost.ConfirmOptimizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar optimizacion"
        Width="540" SizeToContent="Height"
        MinHeight="260" MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

  <Window.Resources>
    <Style x:Key="DlgBtnMain" TargetType="Button">
      <Setter Property="Background"   Value="{StaticResource BrushAccent}"/>
      <Setter Property="Foreground"   Value="#000000"/>
      <Setter Property="FontSize"     Value="12"/>
      <Setter Property="FontWeight"   Value="SemiBold"/>
      <Setter Property="Padding"      Value="22,8"/>
      <Setter Property="Cursor"       Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bdr" Background="{TemplateBinding Background}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bdr" Property="Background" Value="#33E8FF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DlgBtnSec" TargetType="Button">
      <Setter Property="Background"   Value="#1E1E1E"/>
      <Setter Property="Foreground"   Value="#AAAAAA"/>
      <Setter Property="FontSize"     Value="12"/>
      <Setter Property="Padding"      Value="18,8"/>
      <Setter Property="Cursor"       Value="Hand"/>
      <Setter Property="BorderBrush"  Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bdr" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bdr" Property="Background" Value="#2A2A2A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Drop shadow via outer border -->
  <Border Margin="8" CornerRadius="8" Background="#0D0D0D"
          BorderBrush="#2A2A2A" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#000000" Opacity="0.55"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- title bar  -->
        <RowDefinition Height="*"/>     <!-- content    -->
        <RowDefinition Height="Auto"/>  <!-- buttons    -->
      </Grid.RowDefinitions>

      <!-- ── Title bar ──────────────────────────────────────────────────── -->
      <Border Grid.Row="0" Background="#111111" CornerRadius="8,8,0,0"
              Padding="20,13,16,13" MouseLeftButtonDown="OnTitleDrag">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Confirmar optimizacion" Foreground="#EEEEEE"
                       FontSize="13" FontWeight="SemiBold"/>
          </StackPanel>
          <Button x:Name="btnClose" HorizontalAlignment="Right"
                  Width="26" Height="26" Content="×"
                  FontSize="16" FontWeight="Bold"
                  Foreground="#888888" Background="Transparent"
                  BorderThickness="0" Cursor="Hand"
                  Click="OnCancel">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="cbdr" Background="{TemplateBinding Background}"
                        CornerRadius="4" Width="26" Height="26">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="cbdr" Property="Background" Value="#2A0000"/>
                    <Setter Property="Foreground" Value="#EF4444"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>
      </Border>

      <!-- ── Content ────────────────────────────────────────────────────── -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="20,16,20,4" Focusable="False">
        <StackPanel>

          <!-- Summary count -->
          <TextBlock x:Name="lblActionCount" Foreground="#EEEEEE"
                     FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap"/>

          <!-- High-impact warning -->
          <Border x:Name="panelHighImpact" Background="#1A0F00" BorderBrush="#3A2500"
                  BorderThickness="1" CornerRadius="5" Padding="12,9"
                  Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Acciones de impacto alto" Foreground="#F59E0B"
                         FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock x:Name="lblHighImpact" Foreground="#CCAA55"
                         FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Actions grouped by category (populated in code-behind) -->
          <StackPanel x:Name="spActions" Margin="0,0,0,8"/>

          <!-- Restore point note -->
          <Border x:Name="panelRestorePoint" Background="#001A0A" BorderBrush="#003A15"
                  BorderThickness="1" CornerRadius="5" Padding="12,8"
                  Margin="0,4,0,4" Visibility="Collapsed">
            <TextBlock Foreground="#22C55E" FontSize="11" TextWrapping="Wrap"
                       Text="Se creara un punto de restauracion del sistema antes de iniciar."/>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- ── Separator ──────────────────────────────────────────────────── -->
      <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1"
              Background="#1A1A1A" Margin="0,0,0,0"/>

      <!-- ── Buttons ────────────────────────────────────────────────────── -->
      <Grid Grid.Row="2" Margin="20,12,20,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Left: disclaimer -->
        <TextBlock Grid.Column="0" x:Name="lblDisclaimer"
                   Text="Los cambios se pueden revertir desde Historial."
                   Foreground="#555555" FontSize="10" VerticalAlignment="Center"/>
        <!-- Right: action buttons -->
        <Button Grid.Column="1" x:Name="btnCancel" Content="Cancelar"
                Style="{StaticResource DlgBtnSec}" Margin="0,0,8,0"
                Click="OnCancel"/>
        <Button Grid.Column="2" x:Name="btnConfirm" Content="Ejecutar optimizacion"
                Style="{StaticResource DlgBtnMain}"
                Click="OnConfirm"/>
      </Grid>

    </Grid>
  </Border>
</Window>
