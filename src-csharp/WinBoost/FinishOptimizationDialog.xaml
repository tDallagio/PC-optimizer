<Window x:Class="WinBoost.FinishOptimizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimizacion completada"
        Width="480" SizeToContent="Height"
        MinHeight="220" MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

  <Window.Resources>
    <Style x:Key="FinBtnMain" TargetType="Button">
      <Setter Property="Background"      Value="{StaticResource BrushAccent}"/>
      <Setter Property="Foreground"      Value="#000000"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Padding"         Value="22,8"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bdr" Background="{TemplateBinding Background}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bdr" Property="Background" Value="#33E8FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FinBtnSec" TargetType="Button">
      <Setter Property="Background"      Value="#1E1E1E"/>
      <Setter Property="Foreground"      Value="#AAAAAA"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Padding"         Value="18,8"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderBrush"     Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bdr" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bdr" Property="Background" Value="#2A2A2A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="8" CornerRadius="8" Background="#0D0D0D"
          BorderBrush="#2A2A2A" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#000000" Opacity="0.55"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ── Title bar ──────────────────────────────────────────────────── -->
      <Border Grid.Row="0" Background="#111111" CornerRadius="8,8,0,0"
              Padding="20,13,16,13" MouseLeftButtonDown="OnTitleDrag">
        <Grid>
          <TextBlock Text="Optimizacion completada" Foreground="#22C55E"
                     FontSize="13" FontWeight="SemiBold"/>
          <Button HorizontalAlignment="Right" Width="26" Height="26"
                  Content="×" FontSize="16" FontWeight="Bold"
                  Foreground="#888888" Background="Transparent"
                  BorderThickness="0" Cursor="Hand" Click="OnClose">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="cbdr" Background="{TemplateBinding Background}"
                        CornerRadius="4" Width="26" Height="26">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="cbdr" Property="Background" Value="#2A0000"/>
                    <Setter Property="Foreground" Value="#EF4444"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>
      </Border>

      <!-- ── Content ────────────────────────────────────────────────────── -->
      <StackPanel Grid.Row="1" Margin="24,20,24,12">

        <!-- Metricas de resultado -->
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Aplicadas -->
          <Border Grid.Column="0" Background="#001A08" BorderBrush="#003A15"
                  BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,6,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock x:Name="lblAppliedCount" Text="0" FontSize="28" FontWeight="Bold"
                         Foreground="#22C55E" HorizontalAlignment="Center"/>
              <TextBlock Text="aplicadas" FontSize="10" Foreground="#22C55E"
                         HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>

          <!-- Omitidas -->
          <Border Grid.Column="1" Background="#111111" BorderBrush="#2A2A2A"
                  BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,6,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock x:Name="lblSkippedCount" Text="0" FontSize="28" FontWeight="Bold"
                         Foreground="#555555" HorizontalAlignment="Center"/>
              <TextBlock Text="omitidas" FontSize="10" Foreground="#555555"
                         HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>

          <!-- MB liberados -->
          <Border Grid.Column="2" Background="#0A0A1A" BorderBrush="#15153A"
                  BorderThickness="1" CornerRadius="6" Padding="14,12">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock x:Name="lblFreedMb" Text="0" FontSize="28" FontWeight="Bold"
                         Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center"/>
              <TextBlock Text="MB liberados" FontSize="10" Foreground="{StaticResource BrushAccent}"
                         HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Score delta -->
        <Border x:Name="panelScore" Background="#111111" BorderBrush="#1A2A1A"
                BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="PUNTUACION DE OPTIMIZACION" FontSize="9" FontWeight="SemiBold"
                         Foreground="#555555" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="lblScoreBefore" FontSize="20" Foreground="#888888"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" → " FontSize="16" Foreground="#444444"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="lblScoreAfter" FontSize="20" FontWeight="Bold"
                           Foreground="#22C55E" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" x:Name="badgeDelta" Background="#0A2A0A"
                    CornerRadius="5" Padding="10,5" VerticalAlignment="Center"
                    Visibility="Collapsed">
              <TextBlock x:Name="lblDelta" Text="+0" FontSize="18" FontWeight="Bold"
                         Foreground="#22C55E"/>
            </Border>
          </Grid>
        </Border>

        <!-- Nota de reinicio (PageFile) -->
        <Border x:Name="panelReboot" Background="#1A0F00" BorderBrush="#3A2500"
                BorderThickness="1" CornerRadius="5" Padding="12,8"
                Visibility="Collapsed">
          <TextBlock Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap"
                     Text="Algunos cambios (PageFile) requieren reiniciar Windows para aplicarse."/>
        </Border>

      </StackPanel>

      <!-- ── Buttons ────────────────────────────────────────────────────── -->
      <Grid Grid.Row="2" Margin="24,0,24,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Comparativa (visible solo si hay snapshots) -->
        <Button Grid.Column="0" x:Name="btnCompare" Content="Ver comparativa"
                Style="{StaticResource FinBtnSec}" HorizontalAlignment="Left"
                Visibility="Collapsed" Click="OnCompare"/>
        <Button Grid.Column="1" Content="Ver historial" Style="{StaticResource FinBtnSec}"
                Margin="0,0,8,0" Click="OnGoHistory"/>
        <Button Grid.Column="2" Content="Cerrar" Style="{StaticResource FinBtnMain}"
                Click="OnClose"/>
      </Grid>

    </Grid>
  </Border>
</Window>
